@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ThemeState Tema

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">

            <div class="d-flex align-items-center gap-2 ms-auto">
                <button class="theme-toggle-btn btn btn-sm btn-outline-secondary d-flex align-items-center justify-content-center"
                        type="button"
                        title="Cambiar tema oscuro/claro"
                        aria-label="Cambiar tema oscuro/claro"
                        @onclick="ToggleTheme">
                    <i class="bi bi-sun theme-toggle-icon" data-on="bi-moon-stars" data-off="bi-sun"></i>
                </button>

                <AuthorizeView>
                    <Authorized>
                    <div class="dropdown">
                        <button class="btn btn-link text-decoration-none dropdown-toggle d-flex align-items-center gap-2 p-0"
                                type="button"
                                @onclick="ToggleUserMenu"
                                aria-expanded="@isUserMenuOpen">
                            <i class="bi bi-person-circle fs-5 text-primary"></i>
                            <span class="fw-semibold">@context.User.Identity?.Name</span>
                        </button>

                        @if (isUserMenuOpen)
                        {
                            <!-- Fondo transparente para cerrar el menú al hacer clic afuera -->
                            <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1040;" @onclick="CloseUserMenu"></div>

                            <div class="dropdown-menu dropdown-menu-end shadow show position-absolute mt-2" style="right: 1.5rem; min-width: 220px; z-index: 1050;">
                                <div class="px-3 py-2 border-bottom">
                                    <div class="fw-bold text-truncate">@context.User.Identity?.Name</div>
                                    <div class="small text-muted text-truncate">@context.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</div>
                                    <span class="badge bg-secondary mt-1">@context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                                </div>
                                <a href="perfil" class="dropdown-item d-flex align-items-center gap-2 py-2">
                                    <i class="bi bi-person-circle"></i>
                                    <span>Mi Perfil</span>
                                </a>
                                <button class="dropdown-item text-danger d-flex align-items-center gap-2 py-2" @onclick="HandleLogout">
                                    <i class="bi bi-box-arrow-right"></i>
                                    <span>Cerrar sesión</span>
                                </button>
                            </div>
                        }
                    </div>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1">
                            <i class="bi bi-box-arrow-in-right"></i>
                            <span>Iniciar Sesión</span>
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>

        <article class="px-4 py-3">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool isUserMenuOpen = false;

    private void ToggleUserMenu() => isUserMenuOpen = !isUserMenuOpen;
    private void CloseUserMenu() => isUserMenuOpen = false;

    private async Task ToggleTheme()
    {
        // mecanoTheme.toggle() aplica el cambio en <html> y devuelve true si quedó oscuro;
        // se refleja en C# (Tema) para que los gráficos del panel se re-rendericen.
        var oscuro = await JS.InvokeAsync<bool>("window.mecanoTheme.toggle");
        Tema.Set(oscuro);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Sincronizar el estado inicial del tema (puede venir de localStorage o del SO).
            var oscuro = await JS.InvokeAsync<bool>("window.mecanoTheme.isDark");
            Tema.Set(oscuro);

            await JS.InvokeVoidAsync("window.mecanoRedirectFeedback.init", ".nav-scrollable");

            /* Aplicar el filtro de oscurecimiento solo cuando el usuario NO está autenticado */
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;
            await JS.InvokeVoidAsync("window.mecanoRedirectFeedback.setAuthenticated", isAuthenticated);
        }
    }

    private async Task HandleLogout()
    {
        isUserMenuOpen = false;
        try
        {
            // CRÍTICO: Invocamos /api/auth/logout vía fetch de JavaScript con credentials: 'same-origin'
            // para que el navegador reciba la orden de eliminar la cookie de autenticación.
            await JS.InvokeVoidAsync("window.authFetch.logout", "/api/auth/logout");
        }
        catch
        {
            // Ignorar en caso de corte inmediato del circuito
        }

        // Forzar recarga total (forceLoad: true) para reiniciar el circuito como usuario anónimo
        NavigationManager.NavigateTo("/login", forceLoad: true);
    }
}
