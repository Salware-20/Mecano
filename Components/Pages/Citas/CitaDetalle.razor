@page "/citas/{Id:int}"
@attribute [Authorize(Roles = Mecano.Entidad.Constantes.Roles.Administrador + "," + Mecano.Entidad.Constantes.Roles.Mecanico)]
@rendermode InteractiveServer
@using System.Globalization
@using Mecano.Entidad.Constantes
@using Mecano.Entidad.Utilidades
@inject ICitaService CitaService
@inject IVehiculoService VehiculoService
@inject IServicioService ServicioService
@inject IMecanicoService MecanicoService
@inject IJSRuntime JS

<PageTitle>Cita #@Id - Mecano</PageTitle>

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="@(esAdmin ? "citas" : "mecanico/citas")">@(esAdmin ? "Citas" : "Mis citas")</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">Cita #@Id</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="mb-0"><i class="bi bi-calendar-event" aria-hidden="true"></i> Cita #@Id</h1>
    <div class="d-flex flex-wrap gap-2 align-items-center">
        @if (esAdmin)
        {
            @if (cita is not null && EsEditable(cita.Estado))
            {
                @* Transiciones de estado (Confirmar/Cancelar y el respaldo de
                   Iniciar/Finalizar); editar y reprogramar siguen abajo. *@
                <TransicionCita CitaId="@Id" Estado="@cita.Estado" CambioRealizado="Recargar" />
                <button class="btn btn-primary" @onclick="AbrirEditar">
                    <i class="bi bi-pencil" aria-hidden="true"></i> Editar
                </button>
                <button class="btn btn-outline-primary" @onclick="AbrirReprogramar">
                    <i class="bi bi-calendar-week" aria-hidden="true"></i> Reprogramar
                </button>
            }
            <a class="btn btn-outline-secondary" href="citas">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> Volver
            </a>
        }
        else
        {
            @* Solo transiciones de mecánico (Iniciar/Finalizar) o el aviso de
               pendiente; editar y reprogramar son de administración. *@
            @if (citaMec is not null)
            {
                <TransicionCita CitaId="@Id"
                                        Estado="@citaMec.Estado"
                                        CambioRealizado="Recargar" />
            }
            <a class="btn btn-outline-secondary" href="mecanico/citas">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> Volver
            </a>
        }
    </div>
</div>

@if (cargando)
{
    <div class="text-center py-5">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else if (esAdmin && cita is not null)
{
    @if (!string.IsNullOrWhiteSpace(mensajeExito))
    {
        <div class="alert alert-success d-flex align-items-center" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            <div>@mensajeExito</div>
        </div>
    }

    @* ---------- Programación ---------- *@
    <div class="card shadow-sm mb-4">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <strong><i class="bi bi-clock-history"></i> Programación</strong>
            <span class="badge badge-estado @Formatos.BadgeEstado(cita.Estado)">@Formatos.NombreEstado(cita.Estado)</span>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label text-muted small mb-0">Fecha</label>
                    <div>@cita.Fecha.ToString("dddd dd 'de' MMMM 'de' yyyy", EsCr)</div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label text-muted small mb-0">Horario</label>
                    <div>
                        @cita.HoraInicio.ToString("h:mm tt", CultureInfo.InvariantCulture)
                        - @cita.HoraFin.ToString("h:mm tt", CultureInfo.InvariantCulture)
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label text-muted small mb-0">Duración estimada</label>
                    <div>@cita.ServicioDuracionMinutos min</div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label text-muted small mb-0">Registrada</label>
                    <div>@cita.FechaCreacion.ToString("dd/MM/yyyy h:mm tt", CultureInfo.InvariantCulture)</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        @* ---------- Cliente ---------- *@
        <div class="col-12 col-lg-6">
            <div class="card shadow-sm h-100 @(cita.ClienteActivo ? "" : "border-warning")">
                <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <strong><i class="bi bi-person"></i> Cliente</strong>
                    @if (!cita.ClienteActivo)
                    {
                        <span class="badge bg-secondary">Inactivo</span>
                    }
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted fw-normal small">Nombre</dt>
                        <dd class="col-sm-8">
                            @if (cita.ClienteId > 0)
                            {
                                <a href="clientes/@cita.ClienteId" class="text-decoration-none" style="text-transform:capitalize;">
                                    @cita.ClienteNombre
                                </a>
                            }
                            else
                            {
                                <span style="text-transform:capitalize;">@(cita.ClienteNombre ?? "-")</span>
                            }
                        </dd>

                        <dt class="col-sm-4 text-muted fw-normal small">Identificación</dt>
                        <dd class="col-sm-8">@Formatos.FormatearIdentificacion(cita.ClienteCedula, cita.ClienteTipoIdentificacion)</dd>

                        <dt class="col-sm-4 text-muted fw-normal small">Teléfono</dt>
                        <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(cita.ClienteTelefono) ? "-" : Formatos.Telefono(cita.ClienteTelefono))</dd>

                        <dt class="col-sm-4 text-muted fw-normal small">Correo</dt>
                        <dd class="col-sm-8 mb-0">@(string.IsNullOrWhiteSpace(cita.ClienteCorreo) ? "-" : cita.ClienteCorreo)</dd>
                    </dl>

                    @if (!cita.ClienteActivo)
                    {
                        <div class="alert alert-warning d-flex align-items-center py-2 mb-0 mt-3" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            <div>Este cliente está inactivo. Revise su estado antes de continuar.</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ---------- Contacto ---------- *@
        <div class="col-12 col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header">
                    <strong><i class="bi bi-chat-dots"></i> Contacto</strong>
                </div>
                <div class="card-body">
                    @{
                        var msg = WhatsAppHelper.CrearMensajeSegunEstado(cita);
                        var tieneCorreo = !string.IsNullOrWhiteSpace(cita.ClienteCorreo);
                        var tieneTelefono = !string.IsNullOrWhiteSpace(cita.ClienteTelefono);
                        var whatsappValido = WhatsAppHelper.EsValidoParaWhatsApp(cita.ClienteTelefono);
                        var enlaceWhatsApp = whatsappValido ? WhatsAppHelper.CrearEnlace(cita.ClienteTelefono, msg.Cuerpo) : string.Empty;
                        var mailtoEnlace = tieneCorreo ? $"mailto:{cita.ClienteCorreo}?subject={Uri.EscapeDataString(msg.Asunto)}&body={Uri.EscapeDataString(msg.Cuerpo.Replace("\r\n", "\n").Replace("\n", "\r\n"))}" : string.Empty;
                    }

                    @if (!msg.Enviar)
                    {
                        <div class="alert alert-info py-2 mb-0">
                            <i class="bi bi-info-circle"></i> Cita en progreso: no se envía notificación automática.
                        </div>
                    }
                    else
                    {
                        @if (tieneCorreo)
                        {
                            <div class="mb-3">
                                <a class="btn btn-outline-primary w-100" href="@mailtoEnlace">
                                    <i class="bi bi-envelope"></i> Enviar correo
                                </a>
                            </div>
                        }

                        @if (whatsappValido)
                        {
                            <div class="mb-2">
                                <label class="form-label text-muted small mb-1">Mensaje pre-llenado (WhatsApp)</label>
                                <textarea class="form-control" rows="6" readonly>@msg.Cuerpo</textarea>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                <button class="btn btn-success" @onclick="() => AbrirWhatsApp(enlaceWhatsApp, msg.Cuerpo)">
                                    <i class="bi bi-whatsapp"></i> Abrir WhatsApp
                                </button>
                                <button class="btn btn-outline-success" @onclick="() => CopiarMensaje(msg.Cuerpo)">
                                    <i class="bi bi-clipboard"></i> Copiar mensaje
                                </button>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(copiadoMsg))
                            {
                                <small class="text-success d-block mt-2">@copiadoMsg</small>
                            }
                        }
                        else if (tieneTelefono)
                        {
                            <div class="alert alert-warning py-2 mb-0">
                                <small><i class="bi bi-exclamation-triangle"></i> Número telefónico no válido para WhatsApp (se requiere 8 dígitos en Costa Rica).</small>
                            </div>
                        }

                        @if (!tieneCorreo && !whatsappValido)
                        {
                            <p class="text-secondary mb-0">Sin datos de contacto disponibles.</p>
                        }
                    }
                </div>
            </div>
        </div>

        @* ---------- Vehículo ---------- *@
        <div class="col-12 col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header">
                    <strong><i class="bi bi-car-front"></i> Vehículo</strong>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted fw-normal small">Placa</dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrWhiteSpace(cita.VehiculoPlaca))
                            {
                                <a class="badge text-bg-light border text-decoration-none" href="vehiculos/@cita.VehiculoId">@Formatos.Placa(cita.VehiculoPlaca)</a>
                            }
                            else
                            {
                                <span class="text-secondary">-</span>
                            }
                        </dd>

                        <dt class="col-sm-4 text-muted fw-normal small">Marca</dt>
                        <dd class="col-sm-8">@(cita.VehiculoMarca ?? "-")</dd>

                        <dt class="col-sm-4 text-muted fw-normal small">Modelo</dt>
                        <dd class="col-sm-8">@(cita.VehiculoModelo ?? "-")</dd>

                        <dt class="col-sm-4 text-muted fw-normal small">Año</dt>
                        <dd class="col-sm-8 mb-0">@(cita.VehiculoAnio > 0 ? cita.VehiculoAnio.ToString() : "-")</dd>
                    </dl>
                </div>
            </div>
        </div>

        @* ---------- Servicio ---------- *@
        <div class="col-12 col-lg-6">
            <div class="card shadow-sm h-100 @(cita.ServicioActivo ? "" : "border-warning")">
                <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <strong><i class="bi bi-tools"></i> Servicio</strong>
                    @if (!cita.ServicioActivo)
                    {
                        <span class="badge bg-secondary">Inactivo</span>
                    }
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted fw-normal small">Servicio</dt>
                        <dd class="col-sm-8">@(cita.ServicioNombre ?? "-")</dd>

                        <dt class="col-sm-4 text-muted fw-normal small">Duración</dt>
                        <dd class="col-sm-8">@cita.ServicioDuracionMinutos min</dd>

                        <dt class="col-sm-4 text-muted fw-normal small">Precio</dt>
                        <dd class="col-sm-8 mb-0">@Formatos.Moneda(cita.ServicioPrecio)</dd>
                    </dl>

                    @if (!cita.ServicioActivo)
                    {
                        <div class="alert alert-warning d-flex align-items-center py-2 mb-0 mt-3" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            <div>Este servicio fue desactivado: no admite citas nuevas. La cita ya agendada se conserva.</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ---------- Mecánico ---------- *@
        <div class="col-12 col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header">
                    <strong><i class="bi bi-wrench-adjustable"></i> Mecánico</strong>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted fw-normal small">Mecánico@(cita.Mecanicos.Count > 1 ? "s" : "")</dt>
                        <dd class="col-sm-8">
                            @if (cita.Mecanicos.Any())
                            {
                                @foreach (var m in cita.Mecanicos)
                                {
                                    <div style="text-transform:capitalize;">
                                        @m.Nombre
                                        @if (!m.Activo)
                                        {
                                            <span class="badge bg-secondary ms-1">Inactivo</span>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </dd>

                        <dt class="col-sm-4 text-muted fw-normal small">Especialidad</dt>
                        <dd class="col-sm-8 mb-0">@(string.IsNullOrWhiteSpace(cita.Mecanicos.FirstOrDefault()?.EspecialidadNombre) ? "-" : cita.Mecanicos.First().EspecialidadNombre)</dd>
                    </dl>
                </div>
            </div>
        </div>

        @* ---------- Notas ---------- *@
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header">
                    <strong><i class="bi bi-journal-text"></i> Notas</strong>
                </div>
                <div class="card-body">
                    @if (string.IsNullOrWhiteSpace(cita.NotasAdmin))
                    {
                        <p class="text-secondary mb-0">Sin notas registradas.</p>
                    }
                    else
                    {
                        <p class="mb-0" style="white-space:pre-wrap;">@cita.NotasAdmin</p>
                    }
                </div>
            </div>
        </div>
    </div>
}
else if (!esAdmin && citaMec is not null)
{
    @* ============ Vista del mecánico ============
       Misma ficha con la proyección restringida: del cliente solo el nombre,
       sin cédula/teléfono/correo, sin precio del servicio y sin NotasAdmin.
       Las transiciones (Iniciar/Finalizar) viven en la cabecera. *@

    @* ---------- Programación ---------- *@
    <div class="card shadow-sm mb-4">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <strong><i class="bi bi-clock-history" aria-hidden="true"></i> Programación</strong>
            <span class="badge badge-estado @Formatos.BadgeEstado(citaMec.Estado)">@Formatos.NombreEstado(citaMec.Estado)</span>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label text-muted small mb-0">Fecha</label>
                    <div>@citaMec.Fecha.ToString("dddd dd 'de' MMMM 'de' yyyy", EsCr)</div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label text-muted small mb-0">Horario</label>
                    <div>
                        @citaMec.HoraInicio.ToString("h:mm tt", CultureInfo.InvariantCulture)
                        - @citaMec.HoraFin.ToString("h:mm tt", CultureInfo.InvariantCulture)
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label text-muted small mb-0">Duración estimada</label>
                    <div>@citaMec.ServicioDuracionMinutos min</div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label text-muted small mb-0">Registrada</label>
                    <div>@citaMec.FechaCreacion.ToString("dd/MM/yyyy h:mm tt", CultureInfo.InvariantCulture)</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        @* ---------- Cliente (solo nombre) ---------- *@
        <div class="col-12 col-lg-6">
            <div class="card shadow-sm h-100 @(citaMec.ClienteActivo ? "" : "border-warning")">
                <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <strong><i class="bi bi-person" aria-hidden="true"></i> Cliente</strong>
                    @if (!citaMec.ClienteActivo)
                    {
                        <span class="badge bg-secondary">Inactivo</span>
                    }
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted fw-normal small">Nombre</dt>
                        <dd class="col-sm-8 mb-0" style="text-transform:capitalize;">@(citaMec.ClienteNombre ?? "-")</dd>
                    </dl>

                    @if (!citaMec.ClienteActivo)
                    {
                        <div class="alert alert-warning d-flex align-items-center py-2 mb-0 mt-3" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            <div>Este cliente está inactivo. Tenlo en cuenta al atender la cita.</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ---------- Vehículo (datos de trabajo) ---------- *@
        <div class="col-12 col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header">
                    <strong><i class="bi bi-car-front" aria-hidden="true"></i> Vehículo</strong>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted fw-normal small">Placa</dt>
                        <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(citaMec.VehiculoPlaca) ? "-" : Formatos.Placa(citaMec.VehiculoPlaca))</dd>

                        <dt class="col-sm-4 text-muted fw-normal small">Marca</dt>
                        <dd class="col-sm-8">@(citaMec.VehiculoMarca ?? "-")</dd>

                        <dt class="col-sm-4 text-muted fw-normal small">Modelo</dt>
                        <dd class="col-sm-8">@(citaMec.VehiculoModelo ?? "-")</dd>

                        <dt class="col-sm-4 text-muted fw-normal small">Año</dt>
                        <dd class="col-sm-8">@(citaMec.VehiculoAnio > 0 ? citaMec.VehiculoAnio.ToString() : "-")</dd>

                        <dt class="col-sm-4 text-muted fw-normal small">Kilometraje</dt>
                        <dd class="col-sm-8 mb-0">@(citaMec.VehiculoKilometraje is int km ? $"{km:N0} km" : "-")</dd>
                    </dl>

                    @if (!string.IsNullOrWhiteSpace(citaMec.VehiculoNotas))
                    {
                        <hr class="my-3" />
                        <label class="form-label text-muted small mb-1">Notas del vehículo</label>
                        <p class="mb-0" style="white-space:pre-wrap;">@citaMec.VehiculoNotas</p>
                    }
                </div>
            </div>
        </div>

        @* ---------- Servicio (sin precio) ---------- *@
        <div class="col-12 col-lg-6">
            <div class="card shadow-sm h-100 @(citaMec.ServicioActivo ? "" : "border-warning")">
                <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <strong><i class="bi bi-tools" aria-hidden="true"></i> Servicio</strong>
                    @if (!citaMec.ServicioActivo)
                    {
                        <span class="badge bg-secondary">Inactivo</span>
                    }
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted fw-normal small">Servicio</dt>
                        <dd class="col-sm-8">@(citaMec.ServicioNombre ?? "-")</dd>

                        <dt class="col-sm-4 text-muted fw-normal small">Duración</dt>
                        <dd class="col-sm-8 mb-0">@citaMec.ServicioDuracionMinutos min</dd>
                    </dl>

                    @if (!citaMec.ServicioActivo)
                    {
                        <div class="alert alert-warning d-flex align-items-center py-2 mb-0 mt-3" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            <div>Este servicio fue desactivado: no admite citas nuevas. La cita ya agendada se conserva.</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ---------- Mecánicos asignados (solo nombres) ---------- *@
        <div class="col-12 col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header">
                    <strong><i class="bi bi-wrench-adjustable" aria-hidden="true"></i> Mecánico@(citaMec.MecanicosNombres.Count > 1 ? "s" : "")</strong>
                </div>
                <div class="card-body">
                    @if (citaMec.MecanicosNombres.Count > 0)
                    {
                        @foreach (var nombre in citaMec.MecanicosNombres)
                        {
                            <div style="text-transform:capitalize;">@nombre</div>
                        }
                    }
                    else
                    {
                        <span>-</span>
                    }
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-calendar-x display-4 text-muted" aria-hidden="true"></i>
            <h2 class="h5 mt-3">Cita no encontrada</h2>
            <p class="text-muted">
                @(esAdmin
                    ? $"La cita con ID {Id} no existe o fue eliminada."
                    : $"La cita con ID {Id} no existe o no está asignada a tu cuenta.")
            </p>
            <a class="btn btn-primary" href="@(esAdmin ? "citas" : "mecanico/citas")">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                @(esAdmin ? "Volver a citas" : "Volver a mis citas")
            </a>
        </div>
    </div>
}

@if (mostrarModalEditar)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background-color: rgba(0,0,0,.5);" @onclick="CerrarEditar">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content">
                <EditForm Model="modeloEditar" OnValidSubmit="GuardarEdicion">
                    <DataAnnotationsValidator />
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-pencil"></i> Editar cita #@Id</h5>
                        <button type="button" class="btn-close" aria-label="Cerrar" @onclick="CerrarEditar" disabled="@guardando"></button>
                    </div>
                    <div class="modal-body">
                        @if (!string.IsNullOrWhiteSpace(mensajeError))
                        {
                            <div class="alert alert-danger">@mensajeError</div>
                        }

                        <p class="text-secondary small">
                            La fecha, la hora y el mecánico no se modifican aquí.
                        </p>

                        <div class="mb-3">
                            <label class="form-label">Vehículo *</label>
                            <InputSelect class="form-select" @bind-Value="modeloEditar.VehiculoId">
                                @foreach (var v in vehiculos)
                                {
                                    <option value="@v.VehiculoId">@Formatos.Placa(v.Placa) · @v.Marca @v.Modelo@(v.Activo ? "" : " (inactivo)")</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => modeloEditar.VehiculoId" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Servicio *</label>
                            <InputSelect class="form-select" @bind-Value="modeloEditar.ServicioId">
                                @foreach (var s in servicios)
                                {
                                    <option value="@s.Id">@s.Nombre (@s.DuracionMinutos min · @Formatos.Moneda(s.Precio)@(s.Activo ? "" : " (inactivo)"))</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => modeloEditar.ServicioId" />
                        </div>

                        <div class="mb-0">
                            <label class="form-label">Notas</label>
                            <InputTextArea class="form-control" rows="4" @bind-Value="modeloEditar.NotasAdmin" />
                            <ValidationMessage For="() => modeloEditar.NotasAdmin" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CerrarEditar" disabled="@guardando">Cancelar</button>
                        <button type="submit" class="btn btn-primary" disabled="@guardando">
                            @if (guardando)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            }
                            <i class="bi bi-check-lg"></i> Guardar cambios
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (mostrarModalReprogramar)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background-color: rgba(0,0,0,.5);" @onclick="CerrarReprogramar">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content">
                <EditForm Model="modeloReprogramar" OnValidSubmit="GuardarReprogramacion">
                    <DataAnnotationsValidator />
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-calendar-week"></i> Reprogramar cita #@Id</h5>
                        <button type="button" class="btn-close" aria-label="Cerrar" @onclick="CerrarReprogramar" disabled="@guardando"></button>
                    </div>
                    <div class="modal-body">
                        @if (!string.IsNullOrWhiteSpace(mensajeError))
                        {
                            <div class="alert alert-danger">@mensajeError</div>
                        }

                        <p class="text-secondary small">
                            El vehículo, el servicio y las notas no se modifican aquí.
                        </p>

                        @if (cita is not null && cita.Mecanicos.Any(m => !m.Activo))
                        {
                            <div class="alert alert-warning py-2 small" role="alert">
                                <i class="bi bi-exclamation-triangle"></i> Hay mecánicos inactivos asignados. Seleccione solo mecánicos activos para reasignar la cita.
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label">
                                Mecánicos *
                                <span class="text-muted small">(puede elegir varios de la misma especialidad)</span>
                            </label>
                            <div class="border rounded p-2" style="max-height:220px;overflow-y:auto;">
                                @foreach (var grupo in MecanicosPorEspecialidad)
                                {
                                    var habilitado = GrupoHabilitado(grupo.Key);
                                    <div class="mb-2" style="@(habilitado ? "" : "opacity:.5;")">
                                        <div class="text-uppercase text-muted small fw-semibold">
                                            @(string.IsNullOrWhiteSpace(grupo.First().EspecialidadNombre) ? "Sin especialidad" : grupo.First().EspecialidadNombre)
                                            @if (!habilitado)
                                            {
                                                <span class="text-muted small fw-normal">&#32;— misma especialidad requerida</span>
                                            }
                                        </div>
                                        <div class="d-flex flex-wrap gap-3">
                                            @foreach (var m in grupo)
                                            {
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" id="rep-mec-@m.Id"
                                                           checked="@selMecanicosIds.Contains(m.Id)"
                                                           disabled="@(!habilitado)"
                                                           @onchange="e => ToggleMecanicoReprogramar(m.Id, e)" />
                                                    <label class="form-check-label" for="rep-mec-@m.Id" style="text-transform:capitalize;">@m.Nombre</label>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                            @if (!selMecanicosIds.Any())
                            {
                                <div class="form-text text-danger">Seleccione al menos un mecánico.</div>
                            }
                        </div>

                        <div class="row">
                            <div class="col-sm-6 mb-3">
                                <label class="form-label">Fecha *</label>
                                <InputDate class="form-control" @bind-Value="modeloReprogramar.Fecha" @bind-Value:after="CargarOcupados" min="@FechaMinima" />
                            </div>
                            <div class="col-sm-6 mb-3">
                                <label class="form-label">Hora de inicio *</label>
                                <select class="form-select" @bind="horaTexto">
                                    @foreach (var o in OpcionesHora)
                                    {
                                        <option value="@o.Valor" disabled="@(!o.Habilitada)">@o.Etiqueta</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <p class="text-secondary small mb-0">
                            <i class="bi bi-clock"></i> El servicio actual dura @(cita?.ServicioDuracionMinutos ?? 0) min.
                        </p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CerrarReprogramar" disabled="@guardando">Cancelar</button>
                        <button type="submit" class="btn btn-primary" disabled="@guardando">
                            @if (guardando)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            }
                            <i class="bi bi-check-lg"></i> Guardar cambios
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private static readonly CultureInfo EsCr = new("es-CR");
    private string? copiadoMsg;

    private async Task CopiarMensaje(string mensaje)
    {
        try
        {
            var resultado = await JS.InvokeAsync<bool>("mecanoWhatsApp.copiarTexto", mensaje);
            copiadoMsg = resultado ? "Mensaje copiado al portapapeles." : "No se pudo copiar automáticamente. Copie manualmente.";
            StateHasChanged();
            await Task.Delay(2000);
            copiadoMsg = null;
            StateHasChanged();
        }
        catch
        {
            copiadoMsg = "No se pudo copiar automáticamente. Copie manualmente.";
            StateHasChanged();
            await Task.Delay(2000);
            copiadoMsg = null;
            StateHasChanged();
        }
    }

    private async Task AbrirWhatsApp(string enlace, string mensaje)
    {
        await CopiarMensaje(mensaje);
        await JS.InvokeVoidAsync("open", enlace, "_blank");
    }
}
