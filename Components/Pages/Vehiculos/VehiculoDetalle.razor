@page "/vehiculos/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = Mecano.Entidad.Constantes.Roles.Administrador)]
@using System.Globalization
@inject IVehiculoService VehiculoService
@inject ICitaService CitaService
@inject IClienteService ClienteService
@inject IJSRuntime JS

<PageTitle>@(vehiculo is null ? "Vehículo" : Formatos.Placa(vehiculo.Placa)) - Mecano</PageTitle>

<nav aria-label="breadcrumb" class="d-print-none">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="clientes">Clientes</a></li>
        @if (vehiculo?.ClienteId is int clienteId && !string.IsNullOrWhiteSpace(vehiculo.ClienteNombre))
        {
            <li class="breadcrumb-item">
                <a href="clientes/@clienteId" style="text-transform:capitalize;">@vehiculo.ClienteNombre</a>
            </li>
        }
        <li class="breadcrumb-item active" aria-current="page">
            @(vehiculo is null ? "Vehículo" : Formatos.Placa(vehiculo.Placa))
        </li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 d-print-none">
    <h1 class="mb-0">
        <i class="bi bi-car-front"></i>
        @(vehiculo is null ? "Vehículo" : Formatos.Placa(vehiculo.Placa))
    </h1>
    <div class="d-flex align-items-center gap-2">
        <AuthorizeView Roles="Administrador">
            <button type="button" class="btn btn-primary" @onclick="AbrirEdicion" disabled="@(vehiculo is null)">
                <i class="bi bi-pencil"></i> Editar
            </button>
        </AuthorizeView>
        <a class="btn btn-outline-secondary" href="clientes">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(mensajeExito))
{
    <div class="alert alert-success alert-dismissible fade show d-print-none" role="alert">
        @mensajeExito
        <button type="button" class="btn-close" @onclick="() => mensajeExito = null"></button>
    </div>
}

@if (cargando)
{
    <div class="text-center py-5">
        <span class="spinner-border" role="status" aria-hidden="true"></span>
    </div>
}
else if (vehiculo is null)
{
    <div class="alert alert-warning">No se encontró el vehículo solicitado.</div>
}
else
{
    @* ---------- Encabezado del reporte (visible solo al imprimir) ---------- *@
    <div class="d-none d-print-block mb-3">
        <div class="d-flex align-items-center gap-2 mb-2">
            <img src="Mecano-wrench.png" alt="" style="height:2.5rem;" />
            <div>
                <h2 class="mb-0">Mecano</h2>
                <div class="text-muted">Reporte de citas del vehículo</div>
            </div>
        </div>
        <div>
            <strong>Vehículo:</strong> @Formatos.Placa(vehiculo.Placa) — @vehiculo.Marca @vehiculo.Modelo (@vehiculo.Anio)<br />
            <strong>Generado:</strong> @DateTime.Now.ToString("dd/MM/yyyy hh:mm tt", CultureInfo.InvariantCulture)
        </div>
        <hr />
    </div>

    @* ---------- Información general ---------- *@
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <strong><i class="bi bi-info-circle"></i> Información general</strong>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label text-muted small mb-0">Placa</label>
                    <div><span class="badge text-bg-light border">@Formatos.Placa(vehiculo.Placa)</span></div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label text-muted small mb-0">Marca</label>
                    <div>@(string.IsNullOrWhiteSpace(vehiculo.Marca) ? "-" : vehiculo.Marca)</div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label text-muted small mb-0">Modelo</label>
                    <div>@(string.IsNullOrWhiteSpace(vehiculo.Modelo) ? "-" : vehiculo.Modelo)</div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label text-muted small mb-0">Año</label>
                    <div>@(vehiculo.Anio > 0 ? vehiculo.Anio.ToString() : "-")</div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label text-muted small mb-0">Kilometraje</label>
                    <div>@(vehiculo.Kilometraje is int km ? $"{km.ToString("N0", CultureInfo.InvariantCulture)} km" : "-")</div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label text-muted small mb-0">Color</label>
                    <div>@(string.IsNullOrWhiteSpace(vehiculo.Color) ? "-" : vehiculo.Color)</div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label text-muted small mb-0">Dueño</label>
                    <div>
                        @if (vehiculo.ClienteId is int cid && !string.IsNullOrWhiteSpace(vehiculo.ClienteNombre))
                        {
                            <a href="clientes/@cid" class="text-decoration-none" style="text-transform:capitalize;">
                                @vehiculo.ClienteNombre
                            </a>
                        }
                        else
                        {
                            <span class="text-secondary">-</span>
                        }
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label text-muted small mb-0">Estado</label>
                    <div>
                        <span class="badge @(vehiculo.Activo ? "bg-success" : "bg-secondary")">
                            @(vehiculo.Activo ? "Activo" : "Inactivo")
                        </span>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(vehiculo.Notas))
                {
                    <div class="col-12">
                        <label class="form-label text-muted small mb-0">Notas</label>
                        <div style="white-space:pre-wrap;">@vehiculo.Notas</div>
                    </div>
                }
            </div>
        </div>
    </div>

    @* ---------- Historial de citas ---------- *@
    <div class="card shadow-sm mb-4">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <strong><i class="bi bi-calendar-event"></i> Citas (@citas.Count)</strong>
            @if (citas.Any())
            {
                <button type="button" class="btn btn-sm btn-outline-primary d-print-none" @onclick="GenerarReporte">
                    <i class="bi bi-printer"></i> Generar Reporte
                </button>
            }
        </div>
        <div class="card-body">
            @if (!citas.Any())
            {
                <div class="alert alert-info mb-0">Este vehículo no tiene citas registradas.</div>
            }
            else
            {
                @* Resumen por estado: visible en pantalla y en el reporte impreso *@
                <div class="d-flex flex-wrap gap-2 mb-3">
                    @foreach (var estado in EstadosResumen)
                    {
                        <span class="badge @Formatos.BadgeEstado(estado)">
                            @Formatos.NombreEstado(estado): @ContarEstado(estado)
                        </span>
                    }
                </div>

                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Hora</th>
                                <th>Servicio</th>
                                <th>Mecánico</th>
                                <th>Estado</th>
                                <th class="text-end d-print-none">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cita in citas)
                            {
                                <tr>
                                    <td>@cita.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td>@cita.HoraInicio.ToString("hh:mm tt", CultureInfo.InvariantCulture) - @cita.HoraFin.ToString("hh:mm tt", CultureInfo.InvariantCulture)</td>
                                    <td>
                                        @(cita.ServicioNombre ?? "-")
                                        @if (!cita.ServicioActivo)
                                        {
                                            <span class="badge bg-secondary ms-1" title="El servicio fue desactivado; no admite citas nuevas.">Servicio inactivo</span>
                                        }
                                    </td>
                                    <td style="text-transform:capitalize;">@(string.IsNullOrWhiteSpace(cita.MecanicosNombres) ? "-" : cita.MecanicosNombres)</td>
                                    <td>
                                        <span class="badge badge-estado @Formatos.BadgeEstado(cita.Estado)">@Formatos.NombreEstado(cita.Estado)</span>
                                    </td>
                                    <td class="text-end d-print-none">
                                        <a class="btn btn-sm btn-outline-primary" href="citas/@cita.Id">
                                            <i class="bi bi-eye"></i> Ver
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@if (mostrarModalEdicion)
{
    <VehiculoFormModal Model="modeloVehiculo"
                       EsEdicion="true"
                       Guardando="guardando"
                       MensajeError="@mensajeErrorEdicion"
                       OnGuardar="GuardarEdicion"
                       OnCancelar="CerrarEdicion">
        <FooterIzquierdo>
            <button type="button" class="btn btn-outline-primary" @onclick="AbrirTransferencia">
                <i class="bi bi-arrow-left-right"></i> Transferir
            </button>
        </FooterIzquierdo>
    </VehiculoFormModal>
}

@if (mostrarModalTransferencia && vehiculo is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        Transferir vehículo — @Formatos.Placa(vehiculo.Placa)
                    </h5>
                    <button type="button" class="btn-close" @onclick="CancelarTransferencia"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(mensajeErrorTransferencia))
                    {
                        <div class="alert alert-danger">@mensajeErrorTransferencia</div>
                    }

                    @if (clienteDestino is null)
                    {
                        <p class="text-muted small">
                            Cliente actual: <strong style="text-transform:capitalize;">@(vehiculo.ClienteNombre ?? "-")</strong>.
                            Busque el nuevo cliente por nombre o cédula (solo activos).
                        </p>

                        <div class="input-group mb-3">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="text" class="form-control"
                                   placeholder="Buscar por nombre o cédula..."
                                   value="@terminoDestino" @oninput="OnBuscarDestinoCambio" />
                        </div>

                        @if (buscandoDestino)
                        {
                            <div class="text-center py-3">
                                <div class="spinner-border spinner-border-sm" role="status"></div>
                            </div>
                        }
                        else if (!destinos.Any())
                        {
                            <div class="alert alert-info mb-0">
                                @(string.IsNullOrWhiteSpace(terminoDestino)
                                    ? "Escriba para buscar clientes."
                                    : "No se encontraron clientes que coincidan con la búsqueda.")
                            </div>
                        }
                        else
                        {
                            <div class="list-group">
                                @foreach (var d in destinos)
                                {
                                    <button type="button" class="list-group-item list-group-item-action"
                                            @onclick="() => SeleccionarDestino(d)">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <strong style="text-transform:capitalize;">@d.NombreCompleto</strong>
                                                <small class="text-muted d-block">
                                                    @Formatos.CedulaNacional(d.CedulaIdentidad)
                                                </small>
                                            </div>
                                            <i class="bi bi-chevron-right text-muted"></i>
                                        </div>
                                    </button>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <p>
                        Transferir vehículo — @Formatos.Placa(vehiculo.Placa)
                            a <strong style="text-transform:capitalize;">@clienteDestino.NombreCompleto</strong>
                            (@Formatos.CedulaNacional(clienteDestino.CedulaIdentidad))?
                        </p>
                        <p class="text-muted small mb-0">
                            El vehículo quedará activo a nombre del nuevo cliente.
                            Las citas pasadas se mantienen con el cliente anterior.
                        </p>
                    }
                </div>
                <div class="modal-footer justify-content-between">
                    <div>
                        @if (clienteDestino is not null)
                        {
                            <button type="button" class="btn btn-outline-secondary"
                                    @onclick="VolverABusquedaDestino">
                                <i class="bi bi-arrow-left"></i> Volver
                            </button>
                        }
                    </div>
                    <div class="btn-group">
                        <button type="button" class="btn btn-secondary" @onclick="CancelarTransferencia">
                            Cancelar
                        </button>
                        @if (clienteDestino is not null)
                        {
                            <button type="button" class="btn btn-primary" @onclick="TransferirConfirmado"
                                    disabled="@guardando">
                                @if (guardando)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                Transferir
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}
