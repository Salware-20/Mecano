@using Mecano.Entidad.Constantes
@using Mecano.Entidad.Utilidades
@using System.Globalization
@page "/clientes/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = Mecano.Entidad.Constantes.Roles.Administrador)]
@inject IClienteService ClienteService
@inject IVehiculoService VehiculoService
@inject ICitaService CitaService
@inject IComentarioService ComentarioService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS

<PageTitle>@(cliente?.NombreCompleto ?? "Cliente") - Mecano</PageTitle>

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="clientes">Clientes</a></li>
        <li class="breadcrumb-item active" style="text-transform:capitalize;" aria-current="page">@(cliente?.NombreCompleto ?? "Cliente")</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0" style="text-transform:capitalize;"><i class="bi bi-person"></i> @(cliente?.NombreCompleto ?? "Cliente")</h1>
    <a class="btn btn-outline-secondary" href="clientes">
        <i class="bi bi-arrow-left"></i> Volver
    </a>
</div>

@if (!string.IsNullOrEmpty(mensajeExito))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @mensajeExito
        <button type="button" class="btn-close" @onclick="() => mensajeExito = null"></button>
    </div>
}
@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @mensajeError
        <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
    </div>
}

@if (cargando)
{
    <div class="text-center py-5">
        <div class="spinner-border" role="status"></div>
    </div>
}
else if (cliente is null)
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-person-x display-4 text-muted"></i>
            <h2 class="h5 mt-3">Cliente no encontrado</h2>
            <p class="text-muted">
                El cliente con ID @Id no existe o fue eliminado.
            </p>
            <a class="btn btn-primary" href="clientes">
                <i class="bi bi-arrow-left"></i> Volver a clientes
            </a>
        </div>
    </div>
}
else
{
    @* ---------- Tarjeta de datos ---------- *@
    <div class="card shadow-sm mb-4">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <strong><i class="bi bi-card-heading"></i> Datos del cliente</strong>
            <AuthorizeView Roles="Administrador" Context="authCtx">
                <div class="btn-group btn-group-sm">
                    <button class="btn btn-outline-primary" @onclick="AbrirEditar">
                        <i class="bi bi-pencil"></i> Editar
                    </button>
                    @if (cliente.Activo)
                    {
                        <button class="btn btn-outline-warning" @onclick="ConfirmarDesactivar">
                            <i class="bi bi-pause-circle"></i> Desactivar
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-outline-success" disabled="@guardando" @onclick="ConfirmarReactivar">
                            <i class="bi bi-play-circle"></i> Reactivar
                        </button>
                    }
                    @if (SinHistoria)
                    {
                        <button class="btn btn-outline-danger" @onclick="ConfirmarEliminar">
                            <i class="bi bi-trash"></i> Eliminar
                        </button>
                    }
                </div>
            </AuthorizeView>
        </div>
        <div class="card-body">
            <div class="row g-3">
                @* La identificación del cliente solo es visible para el Administrador. *@
                <AuthorizeView Roles="Administrador">
                    <div class="col-sm-6 col-lg-3">
                        <label class="form-label text-muted small mb-0">Identificación</label>
                        <div>@Formatos.FormatearIdentificacion(cliente.CedulaIdentidad, cliente.TipoIdentificacion)</div>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <label class="form-label text-muted small mb-0">Tipo de identificación</label>
                        <div>@cliente.TipoIdentificacion</div>
                    </div>
                </AuthorizeView>
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label text-muted small mb-0">Teléfono</label>
                    <div>@(string.IsNullOrWhiteSpace(cliente.Telefono) ? "-" : Formatos.Telefono(cliente.Telefono))</div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label text-muted small mb-0">Correo</label>
                    <div>@(string.IsNullOrWhiteSpace(cliente.Correo) ? "-" : cliente.Correo)</div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label text-muted small mb-0">Dirección</label>
                    <div>@(string.IsNullOrWhiteSpace(cliente.Direccion) ? "-" : cliente.Direccion)</div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label text-muted small mb-0">Fecha de registro</label>
                    <div>@cliente.FechaRegistro.ToString("dd/MM/yyyy")</div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label text-muted small mb-0">Estado</label>
                    <div>
                        @if (cliente.Activo)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactivo</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ---------- Contactar ---------- *@
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <strong><i class="bi bi-chat-dots"></i> Contacto</strong>
        </div>
        <div class="card-body">
            @{
                var tieneCorreoC = !string.IsNullOrWhiteSpace(cliente.Correo);
                var tieneTelefonoC = !string.IsNullOrWhiteSpace(cliente.Telefono);
                var whatsappValidoC = WhatsAppHelper.EsValidoParaWhatsApp(cliente.Telefono);
                var mensajeWhatsAppC = WhatsAppHelper.CrearMensajeParaCliente(cliente.NombreCompleto);
                var enlaceWhatsAppC = whatsappValidoC ? WhatsAppHelper.CrearEnlace(cliente.Telefono, mensajeWhatsAppC) : string.Empty;
                var mailtoEnlaceC = tieneCorreoC ? $"mailto:{cliente.Correo}?subject={Uri.EscapeDataString($"Mecano - {cliente.NombreCompleto}")}&body={Uri.EscapeDataString(mensajeWhatsAppC.Replace("\r\n", "\n").Replace("\n", "\r\n"))}" : string.Empty;
            }

            <div class="d-flex flex-wrap gap-2">
                @if (tieneCorreoC)
                {
                    <a class="btn btn-outline-primary" href="@mailtoEnlaceC">
                        <i class="bi bi-envelope"></i> Enviar correo
                    </a>
                }
                @if (whatsappValidoC)
                {
                    <button class="btn btn-success" @onclick="() => AbrirWhatsAppCliente(enlaceWhatsAppC, mensajeWhatsAppC)">
                        <i class="bi bi-whatsapp"></i> WhatsApp
                    </button>
                    <button class="btn btn-outline-success" @onclick="() => CopiarMensajeCliente(mensajeWhatsAppC)">
                        <i class="bi bi-clipboard"></i> Copiar mensaje
                    </button>
                }
                else if (tieneTelefonoC)
                {
                    <span class="text-warning small align-self-center"><i class="bi bi-exclamation-triangle"></i> Teléfono no válido para WhatsApp</span>
                }
                @if (!tieneCorreoC && !whatsappValidoC)
                {
                    <span class="text-secondary">Sin datos de contacto disponibles.</span>
                }
            </div>
            @if (whatsappValidoC)
            {
                <div class="mt-3">
                    <label class="form-label text-muted small mb-1">Mensaje pre-llenado</label>
                    <textarea class="form-control" rows="4" readonly>@mensajeWhatsAppC</textarea>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(copiadoMsgCliente))
            {
                <small class="text-success d-block mt-2">@copiadoMsgCliente</small>
            }
        </div>
    </div>

    @* ---------- Vehículos ---------- *@
    <div class="card shadow-sm mb-4">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <strong><i class="bi bi-car-front"></i> Vehículos (@vehiculos.Count)</strong>
            <AuthorizeView Roles="Administrador" Context="authCtx">
                <button class="btn btn-sm btn-primary" @onclick="AbrirCrearVehiculo">
                    <i class="bi bi-plus-circle"></i> Nuevo vehículo
                </button>
            </AuthorizeView>
        </div>
        <div class="card-body">
            @if (!vehiculos.Any())
            {
                <div class="alert alert-info mb-0">Este cliente no tiene vehículos registrados.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Placa</th>
                                <th>Marca</th>
                                <th>Modelo</th>
                                <th class="text-center">Año</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var veh in vehiculos)
                            {
                                <tr class="@(veh.Activo ? "" : "table-secondary")">
                                    <td>
                                        <strong>@Formatos.Placa(veh.Placa)</strong>
                                        @if (!veh.Activo)
                                        {
                                            <span class="badge bg-secondary ms-1">Inactivo</span>
                                        }
                                    </td>
                                    <td>@veh.Marca</td>
                                    <td>@veh.Modelo</td>
                                    <td class="text-center">@veh.Anio</td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-secondary me-1" href="vehiculos/@veh.VehiculoId">
                                            <i class="bi bi-eye"></i> Ver
                                        </a>
                                        <AuthorizeView Roles="Administrador" Context="authCtx">
                                            <button class="btn btn-sm btn-outline-primary"
                                                    @onclick="() => AbrirEditarVehiculo(veh)">
                                                <i class="bi bi-pencil"></i> Editar
                                            </button>
                                        </AuthorizeView>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @* ---------- Citas ---------- *@
    <div class="card shadow-sm mb-4">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <strong><i class="bi bi-calendar-event"></i> Citas (@citas.Count)</strong>
            <button class="btn btn-sm btn-primary" disabled
                    title="Disponible en la siguiente fase">
                <i class="bi bi-plus-circle"></i> Agendar cita
            </button>
        </div>
        <div class="card-body">
            @if (!citas.Any())
            {
                <div class="alert alert-info mb-0">Este cliente no tiene citas registradas.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Hora</th>
                                <th>Servicio</th>
                                <th>Mecánico</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cita in citas)
                            {
                                <tr>
                                    <td>@cita.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td>@cita.HoraInicio.ToString("h:mm tt", CultureInfo.InvariantCulture) - @cita.HoraFin.ToString("h:mm tt", CultureInfo.InvariantCulture)</td>
                                    <td>
                                        @(cita.ServicioNombre ?? "-")
                                        @if (!cita.ServicioActivo)
                                        {
                                            <span class="badge bg-secondary ms-1" title="El servicio fue desactivado; no admite citas nuevas.">Servicio inactivo</span>
                                        }
                                    </td>
                                    <td style="text-transform:capitalize;">@(string.IsNullOrWhiteSpace(cita.MecanicosNombres) ? "-" : cita.MecanicosNombres)</td>
                                    <td>
                                        <span class="badge badge-estado @Formatos.BadgeEstado(cita.Estado)">@Formatos.NombreEstado(cita.Estado)</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @* ---------- Comentarios (Administrador y Mecánico) ---------- *@
    <div class="card shadow-sm mb-4">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <strong><i class="bi bi-chat-left-text" aria-hidden="true"></i> Comentarios (@comentarios.Count)</strong>
            <button class="btn btn-sm btn-primary" @onclick="AbrirCrearComentario">
                <i class="bi bi-plus-circle" aria-hidden="true"></i> Nuevo comentario
            </button>
        </div>
        <div class="card-body">
            @if (cargandoComentarios)
            {
                <div class="text-center py-3">
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span class="ms-2 text-secondary small">Cargando comentarios…</span>
                </div>
            }
            else if (!comentarios.Any())
            {
                <div class="text-center py-4">
                    <i class="bi bi-chat-left-text display-6 text-secondary" aria-hidden="true"></i>
                    <h2 class="h6 mt-2 mb-1">Sin comentarios</h2>
                    <p class="text-secondary small mb-3">
                        @(errorCargaComentarios
                            ? "No se pudieron cargar los comentarios. Intentá de nuevo."
                            : "Todavía no hay notas sobre este cliente.")
                    </p>
                    <button class="btn btn-sm btn-outline-primary" @onclick="AbrirCrearComentario">
                        <i class="bi bi-plus-circle" aria-hidden="true"></i> Escribir el primero
                    </button>
                </div>
            }
            else
            {
                <ul class="list-group list-group-flush comentarios-lista">
                    @foreach (var c in comentarios)
                    {
                        <li class="list-group-item px-0">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div>
                                    <span class="fw-semibold" style="text-transform:capitalize;">@c.AutorNombre</span>
                                    <span class="badge text-bg-@(c.AutorTipo == TipoAutorComentario.Administrador ? "info" : "secondary") ms-1">
                                        @c.AutorTipo
                                    </span>
                                    <div class="small text-secondary">
                                        <i class="bi bi-clock" aria-hidden="true"></i>
                                        <time datetime="@c.FechaHora.ToString("yyyy-MM-ddTHH:mm")">
                                            @c.FechaHora.ToString("dd/MM/yyyy h:mm tt", CultureInfo.InvariantCulture)
                                        </time>
                                    </div>
                                </div>
                                @* Solo el autor ve el botón de eliminar *@
                                @if (EsAutor(c))
                                {
                                    <button class="btn btn-sm btn-outline-danger comentario-btn-eliminar flex-shrink-0"
                                            title="Eliminar comentario"
                                            aria-label="Eliminar comentario"
                                            @onclick="() => ConfirmarEliminarComentario(c)">
                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                    </button>
                                }
                            </div>
                            <p class="mb-0 mt-1 comentario-texto">@c.Texto</p>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    @* ---------- Modal: nuevo comentario ---------- *@
    @if (mostrarModalComentario)
    {
        <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true"
             aria-labelledby="tituloNuevoComentario" style="background:rgba(0,0,0,.5);"
             @onkeydown="OnKeyDownModalComentario">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <EditForm Model="modeloComentario" OnValidSubmit="GuardarComentario" FormName="ComentarioCliente">
                        <DataAnnotationsValidator />
                        <div class="modal-header">
                            <h5 class="modal-title" id="tituloNuevoComentario">
                                <i class="bi bi-chat-left-text" aria-hidden="true"></i> Nuevo comentario
                            </h5>
                            <button type="button" class="btn-close" aria-label="Cerrar"
                                    @onclick="CerrarCrearComentario"></button>
                        </div>
                        <div class="modal-body">
                            <p class="text-secondary small">
                                Comentario para <strong style="text-transform:capitalize;">@(cliente?.NombreCompleto ?? "-")</strong>.
                                Quedará con tu nombre y la fecha de hoy.
                            </p>

                            <div class="mb-2">
                                <label class="form-label" for="nuevoComentarioTexto">Comentario *</label>
                                <InputTextArea id="nuevoComentarioTexto" class="form-control" rows="4"
                                               @bind-Value="modeloComentario.Texto"
                                               placeholder="Escribí una nota sobre este cliente…"
                                               maxlength="1000" autocapitalize="sentences"
                                               aria-describedby="ayudaComentario" />
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <ValidationMessage For="() => modeloComentario.Texto"
                                                       class="text-danger small mb-0" />
                                    <small id="ayudaComentario" class="text-secondary ms-auto">
                                        @(modeloComentario.Texto?.Length ?? 0)/1000
                                    </small>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CerrarCrearComentario">Cancelar</button>
                            <button type="button" class="btn btn-primary" disabled="@guardando" @onclick="GuardarComentario">
                                @if (guardando)
                                {
                                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                }
                                else
                                {
                                    <i class="bi bi-send" aria-hidden="true"></i>
                                }
                                Publicar comentario 
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }

    @* ---------- Modal: eliminar comentario ---------- *@
    @if (comentarioAEliminar is not null)
    {
        <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true"
             aria-labelledby="tituloEliminarComentario" style="background:rgba(0,0,0,.5);"
             @onkeydown="OnKeyDownModalComentario">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title text-danger" id="tituloEliminarComentario">
                            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> Eliminar comentario
                        </h5>
                        <button type="button" class="btn-close" aria-label="Cerrar"
                                @onclick="CancelarEliminarComentario"></button>
                    </div>
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(mensajeError))
                        {
                            <div class="alert alert-danger" role="alert">@mensajeError</div>
                        }
                        else
                        {
                            <p>¿Eliminar este comentario de <strong style="text-transform:capitalize;">@comentarioAEliminar.AutorNombre</strong>?</p>

                            <figure class="bg-body-tertiary border rounded p-3 mb-3">
                                <blockquote class="mb-1">@PrevioComentario(comentarioAEliminar.Texto)</blockquote>
                                <figcaption class="small text-secondary">
                                    @comentarioAEliminar.FechaHora.ToString("dd/MM/yyyy h:mm tt", CultureInfo.InvariantCulture)
                                </figcaption>
                            </figure>

                            <p class="text-secondary small mb-0">
                                <i class="bi bi-info-circle" aria-hidden="true"></i>
                                Esta acción no se puede deshacer. Si querés corregir el texto,
                                cancelá y publicá un comentario nuevo.
                            </p>
                        }
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="CancelarEliminarComentario">Cancelar</button>
                        <button class="btn btn-danger" @onclick="EliminarComentarioConfirmado" disabled="@guardando">
                            @if (guardando)
                            {
                                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                            }
                            else
                            {
                                <i class="bi bi-trash" aria-hidden="true"></i>
                            }
                            Eliminar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @* ---------- Modales (solo Administrador) ---------- *@
    <AuthorizeView Roles="Administrador" Context="authCtx">
        @if (mostrarModal)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5);">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <EditForm Model="modelo" OnValidSubmit="Guardar" FormName="clienteDetalleForm">
                            <DataAnnotationsValidator />
                            <div class="modal-header">
                                <h5 class="modal-title">Editar cliente</h5>
                                <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                            </div>
                            <div class="modal-body">
                                @if (!string.IsNullOrEmpty(mensajeError))
                                {
                                    <div class="alert alert-danger">@mensajeError</div>
                                }

                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label" for="detTipoId">Tipo Identificación *</label>
                                        <InputSelect id="detTipoId" class="form-select" @bind-Value="modelo.TipoIdentificacion">
                                            <option value="@Mecano.Entidad.Constantes.TipoIdentificacion.Nacional">Nacional</option>
                                            <option value="@Mecano.Entidad.Constantes.TipoIdentificacion.Dimex">DIMEX</option>
                                            <option value="@Mecano.Entidad.Constantes.TipoIdentificacion.Pasaporte">Pasaporte</option>
                                        </InputSelect>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label" for="detCedula">Identificación *</label>
                                        <InputText id="detCedula" class="form-control" @bind-Value="modelo.CedulaIdentidad" maxlength="20"
                                                   placeholder="Número de documento" />
                                        <ValidationMessage For="() => modelo.CedulaIdentidad" class="text-danger small" />
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label" for="detNombre">Nombre completo *</label>
                                        <InputText id="detNombre" class="form-control" @bind-Value="modelo.NombreCompleto" maxlength="150"
                                               autocapitalize="words" style="text-transform:capitalize;"
                                                   placeholder="Nombre y apellidos" />
                                        <ValidationMessage For="() => modelo.NombreCompleto" class="text-danger small" />
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label" for="detTelefono">Teléfono *</label>
                                        <InputText id="detTelefono" class="form-control" @bind-Value="modelo.Telefono" type="tel" inputmode="numeric" maxlength="20"
                                                   placeholder="Ej. 88888888" />
                                        <ValidationMessage For="() => modelo.Telefono" class="text-danger small" />
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label" for="detCorreo">Correo</label>
                                        <InputText id="detCorreo" class="form-control" @bind-Value="modelo.Correo" type="email" maxlength="200"
                                                   placeholder="cliente@correo.com" />
                                        <ValidationMessage For="() => modelo.Correo" class="text-danger small" />
                                    </div>
                                </div>

                                <div class="mb-1">
                                    <label class="form-label" for="detDireccion">Dirección</label>
                                    <InputTextArea id="detDireccion" class="form-control" @bind-Value="modelo.Direccion" maxlength="300"
                                                   rows="2" placeholder="Dirección opcional" />
                                    <ValidationMessage For="() => modelo.Direccion" class="text-danger small" />
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" @onclick="CerrarModal">
                                    Cancelar
                                </button>
                                <button type="submit" class="btn btn-primary" disabled="@guardando">
                                    @if (guardando)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                    }
                                    Guardar
                                </button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        }

        @if (mostrarModalVehiculo)
        {
            <VehiculoFormModal Model="modeloVehiculo"
                               EsEdicion="vehiculoEditando is not null"
                               Guardando="guardando"
                               MensajeError="@mensajeError"
                               OnGuardar="GuardarVehiculo"
                               OnCancelar="CerrarModalVehiculo">
                <FooterIzquierdo>
                    @if (vehiculoEditando is not null)
                    {
                        <button type="button" class="btn btn-outline-danger me-1"
                                @onclick="ConfirmarEliminarVehiculo">
                            <i class="bi bi-trash"></i> Eliminar
                        </button>
                        <button type="button" class="btn btn-outline-primary"
                                @onclick="AbrirTransferencia">
                            <i class="bi bi-arrow-left-right"></i> Transferir
                        </button>
                    }
                </FooterIzquierdo>
            </VehiculoFormModal>
        }

        @if (clienteADesactivar is not null)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5);">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Confirmar desactivación</h5>
                        </div>
                        <div class="modal-body">
                            @if (!string.IsNullOrEmpty(mensajeError))
                            {
                                <div class="alert alert-danger">@mensajeError</div>
                            }
                            else
                            {
                                <p>¿Desactivar al cliente <strong style="text-transform:capitalize;">@clienteADesactivar.NombreCompleto</strong>?</p>
                                <p class="text-muted small">
                                    El cliente dejará de aparecer en las listas, pero se conserva su historial.
                                </p>
                                @if (citasFuturas > 0)
                                {
                                    <p class="text-warning small mb-0">
                                        Este cliente tiene @citasFuturas citas futuras. Seguirán agendadas;
                                        cancelalas manualmente si corresponde.
                                    </p>
                                }
                            }
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-secondary" @onclick="CancelarDesactivar">Cancelar</button>
                            <button class="btn btn-warning" @onclick="DesactivarConfirmado" disabled="@guardando">
                                Desactivar
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (clienteAEliminar is not null)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5);">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Confirmar eliminación definitiva</h5>
                        </div>
                        <div class="modal-body">
                            @if (!string.IsNullOrEmpty(mensajeError))
                            {
                                <div class="alert alert-danger">@mensajeError</div>
                            }
                            else
                            {
                                <p>
                                    ¿Eliminar permanentemente a <strong style="text-transform:capitalize;">@clienteAEliminar.NombreCompleto</strong>
                                    (@Formatos.CedulaNacional(clienteAEliminar.CedulaIdentidad))?
                                </p>
                                <p class="text-muted small mb-0">
                                    Esta acción no se puede deshacer. Si solo quieres ocultarlo del listado,
                                    usa Desactivar.
                                </p>
                            }
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-secondary" @onclick="CancelarEliminar">Cancelar</button>
                            <button class="btn btn-danger" @onclick="EliminarConfirmado" disabled="@guardando">
                                <i class="bi bi-trash"></i> Eliminar definitivamente
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (vehiculoAEliminar is not null)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5);">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Confirmar eliminación de vehículo</h5>
                        </div>
                        <div class="modal-body">
                            @if (!string.IsNullOrEmpty(mensajeError))
                            {
                                <div class="alert alert-danger">@mensajeError</div>
                            }
                            else
                            {
                                <p>
                                    ¿Eliminar el vehículo
                                    <strong>@Formatos.Placa(vehiculoAEliminar.Placa)</strong>
                                    (@vehiculoAEliminar.Marca @vehiculoAEliminar.Modelo)?
                                </p>
                                <p class="text-muted small mb-0">
                                    El vehículo dejará de aparecer en las listas, pero se
                                    conserva su historial de citas.
                                </p>
                            }
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-secondary" @onclick="CancelarEliminarVehiculo">Cancelar</button>
                            <button class="btn btn-danger" @onclick="EliminarVehiculoConfirmado" disabled="@guardando">
                                <i class="bi bi-trash"></i> Eliminar
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (clienteAReactivar is not null)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5);">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Confirmar reactivación</h5>
                        </div>
                        <div class="modal-body">
                            @if (!string.IsNullOrEmpty(mensajeError))
                            {
                                <div class="alert alert-danger">@mensajeError</div>
                            }
                            else
                            {
                                <p>¿Reactivar al cliente <strong style="text-transform:capitalize;">@clienteAReactivar.NombreCompleto</strong>?</p>
                                @if (vehiculos.Count > 0)
                                {
                                    <p class="text-warning small mb-0">
                                        Al reactivar este cliente, TODOS sus vehículos (@vehiculos.Count)
                                        se reactivarán también.
                                    </p>
                                }
                            }
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-secondary" @onclick="CancelarReactivar">Cancelar</button>
                            <button class="btn btn-success" @onclick="ReactivarConfirmado" disabled="@guardando">
                                <i class="bi bi-play-circle"></i> Reactivar
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (vehiculoATransferir is not null)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5);">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">
                                Transferir vehículo — @Formatos.Placa(vehiculoATransferir.Placa)
                            </h5>
                            <button type="button" class="btn-close" @onclick="CancelarTransferencia"></button>
                        </div>
                        <div class="modal-body">
                            @if (!string.IsNullOrEmpty(mensajeError))
                            {
                                <div class="alert alert-danger">@mensajeError</div>
                            }

                            @if (clienteDestino is null)
                            {
                                <p class="text-muted small">
                                    Cliente actual: <strong style="text-transform:capitalize;">@(cliente?.NombreCompleto ?? "-")</strong>.
                                    Busque el nuevo cliente por nombre o cédula (solo activos).
                                </p>

                                <div class="input-group mb-3">
                                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                                    <input type="text" class="form-control"
                                           placeholder="Buscar por nombre o cédula..."
                                           value="@terminoDestino" @oninput="OnBuscarDestinoCambio" />
                                </div>

                                @if (buscandoDestino)
                                {
                                    <div class="text-center py-3">
                                        <div class="spinner-border spinner-border-sm" role="status"></div>
                                    </div>
                                }
                                else if (!destinos.Any())
                                {
                                    <div class="alert alert-info mb-0">
                                        @(string.IsNullOrWhiteSpace(terminoDestino)
                                            ? "Escriba para buscar clientes."
                                            : "No se encontraron clientes que coincidan con la búsqueda.")
                                    </div>
                                }
                                else
                                {
                                    <div class="list-group">
                                        @foreach (var d in destinos)
                                        {
                                            <button type="button" class="list-group-item list-group-item-action"
                                                    @onclick="() => SeleccionarDestino(d)">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div>
                                                        <strong style="text-transform:capitalize;">@d.NombreCompleto</strong>
                                                        <small class="text-muted d-block">
                                                            @Formatos.CedulaNacional(d.CedulaIdentidad)
                                                        </small>
                                                    </div>
                                                    <i class="bi bi-chevron-right text-muted"></i>
                                                </div>
                                            </button>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <p>
                                    ¿Transferir el vehículo <strong>@Formatos.Placa(vehiculoATransferir.Placa)</strong>
                                    a <strong style="text-transform:capitalize;">@clienteDestino.NombreCompleto</strong>
                                    (@Formatos.CedulaNacional(clienteDestino.CedulaIdentidad))?
                                </p>
                                <p class="text-muted small mb-0">
                                    El vehículo quedará activo a nombre del nuevo cliente.
                                    Las citas pasadas se mantienen con el cliente anterior.
                                </p>
                            }
                        </div>
                        <div class="modal-footer justify-content-between">
                            <div>
                                @if (clienteDestino is not null)
                                {
                                    <button type="button" class="btn btn-outline-secondary"
                                            @onclick="VolverABusquedaDestino">
                                        <i class="bi bi-arrow-left"></i> Volver
                                    </button>
                                }
                            </div>
                            <div class="btn-group">
                                <button type="button" class="btn btn-secondary" @onclick="CancelarTransferencia">
                                    Cancelar
                                </button>
                                @if (clienteDestino is not null)
                                {
                                    <button type="button" class="btn btn-primary" @onclick="TransferirConfirmado"
                                            disabled="@guardando">
                                        @if (guardando)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1"></span>
                                        }
                                        Transferir
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </AuthorizeView>
}

@code {
    private string? copiadoMsgCliente;

    private async Task CopiarMensajeCliente(string mensaje)
    {
        try
        {
            var resultado = await JS.InvokeAsync<bool>("mecanoWhatsApp.copiarTexto", mensaje);
            copiadoMsgCliente = resultado ? "Mensaje copiado al portapapeles." : "No se pudo copiar automáticamente. Copie manualmente.";
            StateHasChanged();
            await Task.Delay(2000);
            copiadoMsgCliente = null;
            StateHasChanged();
        }
        catch
        {
            copiadoMsgCliente = "No se pudo copiar automáticamente. Copie manualmente.";
            StateHasChanged();
            await Task.Delay(2000);
            copiadoMsgCliente = null;
            StateHasChanged();
        }
    }

    private async Task AbrirWhatsAppCliente(string enlace, string mensaje)
    {
        await CopiarMensajeCliente(mensaje);
        await JS.InvokeVoidAsync("open", enlace, "_blank");
    }
}
