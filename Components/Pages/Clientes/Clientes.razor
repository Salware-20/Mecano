@page "/clientes"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable
@using Mecano.Entidad.Constantes
@using System.Globalization
@inject IClienteService ClienteService
@inject ICitaService CitaService
@inject IVehiculoService VehiculoService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Clientes - Mecano</PageTitle>

<h1><i class="bi bi-people"></i> Gestión de Clientes</h1>

@if (!string.IsNullOrEmpty(mensajeExito))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @mensajeExito
        <button type="button" class="btn-close" @onclick="() => mensajeExito = null"></button>
    </div>
}
@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @mensajeError
        <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-header">
        <div class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" placeholder="@TextoPlaceholderBusqueda()"
                           value="@terminoBusqueda" @oninput="OnBuscarCambio" />
                    @if (!string.IsNullOrEmpty(terminoBusqueda))
                    {
                        <button class="btn btn-outline-secondary" type="button" title="Limpiar búsqueda"
                                @onclick="LimpiarBusqueda">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    }
                </div>
            </div>
            <div class="col-md-3">
                <div class="d-flex align-items-center gap-2">
                    <label class="form-label mb-0 text-nowrap" for="selClientesEstado">Estado</label>
                    <select id="selClientesEstado" class="form-select form-select-sm"
                            value="@filtro" @onchange="CambiarFiltro">
                        <option value="@FiltroActivo.Activos">Activos</option>
                        <option value="@FiltroActivo.Inactivos">Inactivos</option>
                        <option value="@FiltroActivo.Todos">Todos</option>
                    </select>
                </div>
            </div>
            <div class="col-md-2">
                <select class="form-select form-select-sm" value="@tamanioPagina" @onchange="CambiarTamanioPagina">
                    @foreach (var t in TamaniosPagina)
                    {
                        <option value="@t">@t por página</option>
                    }
                </select>
            </div>
            <div class="col-md-2 text-md-end">
                <AuthorizeView Roles="Administrador" Context="authCtx">
                    <button class="btn btn-primary w-100" @onclick="AbrirCrear">
                        <i class="bi bi-plus-circle"></i> Nuevo cliente
                    </button>
                </AuthorizeView>
            </div>
        </div>
    </div>

    <div class="card-body">
        @if (cargando)
        {
            <div class="text-center py-4">
                <div class="spinner-border" role="status"></div>
            </div>
        }
        else if (!clientes.Any())
        {
            <div class="alert alert-info mb-0">
                @TextoVacio()
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="expand-cell"><span class="visually-hidden">Detalle</span></th>
                            @* La identificación del cliente solo es visible para el Administrador. *@
                            <AuthorizeView Roles="Administrador">
                                <th>Identificación</th>
                            </AuthorizeView>
                            <th>Nombre</th>
                            <th>Contacto</th>
                            <th class="text-center">Vehículos</th>
                            <th class="text-center">Citas</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cli in clientes)
                        {
                            <tr class="fila-cliente @(cli.Activo ? "" : "table-secondary") @(EstaExpandido(cli.Id) ? "table-active" : "")"
                                @onclick="() => ToggleFila(cli)">
                                <td class="expand-cell text-center">
                                    <button type="button" class="btn btn-sm btn-link expand-btn p-0"
                                            aria-expanded="@EstaExpandido(cli.Id)"
                                            aria-controls="@IdDetalle(cli.Id)"
                                            aria-label="@(EstaExpandido(cli.Id) ? "Ocultar" : "Mostrar") vehículos y citas de @cli.NombreCompleto">
                                        <i class="bi @(EstaExpandido(cli.Id) ? "bi-chevron-down" : "bi-chevron-right")" aria-hidden="true"></i>
                                    </button>
                                </td>
                                @* La identificación del cliente solo es visible para el Administrador. *@
                                <AuthorizeView Roles="Administrador">
                                    <td>
                                        <span>@Formatos.FormatearIdentificacion(cli.CedulaIdentidad, cli.TipoIdentificacion)</span>
                                        <small class="text-muted d-block">@cli.TipoIdentificacion</small>
                                    </td>
                                </AuthorizeView>
                                <td style="text-transform:capitalize;"><strong>@cli.NombreCompleto</strong></td>
                                <td>
                                    @Formatos.Telefono(cli.Telefono)
                                    @if (!string.IsNullOrWhiteSpace(cli.Correo))
                                    {
                                        <small class="text-muted d-block">@cli.Correo</small>
                                    }
                                </td>
                                <td class="text-center">@cli.CantidadVehiculos</td>
                                <td class="text-center">@cli.CantidadCitas</td>
                                <td class="text-center">
                                    @if (cli.Activo)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactivo</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-primary me-1" href="clientes/@cli.Id"
                                       @onclick:stopPropagation="true">
                                        <i class="bi bi-eye"></i> Ver
                                    </a>
                                    <AuthorizeView Roles="Administrador" Context="authCtx">
                                        <button class="btn btn-sm btn-outline-primary me-1"
                                                title="Editar" @onclick="() => AbrirEditar(cli)"
                                                @onclick:stopPropagation="true">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        @if (cli.Activo)
                                        {
                                            <button class="btn btn-sm btn-outline-warning me-1"
                                                    title="Desactivar" @onclick="() => ConfirmarDesactivar(cli)"
                                                    @onclick:stopPropagation="true">
                                                <i class="bi bi-pause-circle"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-success me-1"
                                                    title="Reactivar" disabled="@guardando"
                                                    @onclick="() => ConfirmarReactivar(cli)"
                                                    @onclick:stopPropagation="true">
                                                <i class="bi bi-play-circle"></i>
                                            </button>
                                        }
                                        @if (SinHistoria(cli))
                                        {
                                            <button class="btn btn-sm btn-outline-danger"
                                                    title="Eliminar definitivamente" @onclick="() => ConfirmarEliminar(cli)"
                                                    @onclick:stopPropagation="true">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </AuthorizeView>
                                </td>
                            </tr>

                            @if (EstaExpandido(cli.Id))
                            {
                                <tr class="detalle-row">
                                    <td colspan="@(incluirIdentificacion ? 8 : 7)" class="p-0">
                                        <div id="@IdDetalle(cli.Id)" class="detalle-panel p-3">
                                            @if (detalleCargando.Contains(cli.Id))
                                            {
                                                <div class="text-center py-3">
                                                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                                    <span class="ms-2 text-secondary small">Cargando vehículos y citas…</span>
                                                </div>
                                            }
                                            else if (detalleError.Contains(cli.Id))
                                            {
                                                <div class="d-flex align-items-center gap-2 text-secondary small">
                                                    <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                                                    <span>No se pudo cargar el detalle de este cliente.</span>
                                                    <button type="button" class="btn btn-sm btn-outline-secondary ms-auto"
                                                            @onclick:stopPropagation="true"
                                                            @onclick="() => RecargarDetalle(cli)">
                                                        Reintentar
                                                    </button>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="row g-3">
                                                    <div class="col-12 col-xl-4">
                                                        <div class="detalle-seccion-titulo">
                                                            <i class="bi bi-car-front" aria-hidden="true"></i>
                                                            <strong>Vehículos</strong>
                                                            <span class="badge text-bg-light border">@VehiculosDe(cli.Id).Count</span>
                                                        </div>
                                                        @if (!VehiculosDe(cli.Id).Any())
                                                        {
                                                            <p class="text-secondary small mb-0">Este cliente no tiene vehículos registrados.</p>
                                                        }
                                                        else
                                                        {
                                                            <div class="d-flex flex-column gap-2">
                                                                @foreach (var veh in VehiculosDe(cli.Id))
                                                                {
                                                                    <div class="vehiculo-item d-flex align-items-center gap-2">
                                                                        <a class="placa-badge text-decoration-none" href="vehiculos/@veh.VehiculoId">@Formatos.Placa(veh.Placa)</a>
                                                                        <div class="min-w-0 flex-grow-1">
                                                                            <div class="fw-semibold text-truncate">@veh.Marca @veh.Modelo</div>
                                                                            <div class="text-secondary small">
                                                                                @veh.Anio@(string.IsNullOrWhiteSpace(veh.Color) ? "" : $" · {veh.Color}")
                                                                            </div>
                                                                        </div>
                                                                        @if (!veh.Activo)
                                                                        {
                                                                            <span class="badge bg-secondary">Inactivo</span>
                                                                        }
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                    </div>

                                                    <div class="col-12 col-xl-8">
                                                        <div class="detalle-seccion-titulo">
                                                            <i class="bi bi-calendar-event" aria-hidden="true"></i>
                                                            <strong>Citas agendadas</strong>
                                                            <span class="badge text-bg-light border">@CitasDe(cli.Id).Count</span>
                                                        </div>
                                                        @if (!CitasDe(cli.Id).Any())
                                                        {
                                                            <p class="text-secondary small mb-0">Este cliente no tiene citas agendadas.</p>
                                                        }
                                                        else
                                                        {
                                                            <div class="table-responsive">
                                                                <table class="table table-sm align-middle mb-0 citas-mini">
                                                                    <thead>
                                                                        <tr>
                                                                            <th>Fecha</th>
                                                                            <th>Hora</th>
                                                                            <th>Placa</th>
                                                                            <th>Servicio</th>
                                                                            <th>Mecánico</th>
                                                                            <th class="text-center">Estado</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        @foreach (var cita in CitasDe(cli.Id).OrderByDescending(c => c.Fecha).ThenByDescending(c => c.HoraInicio))
                                                                        {
                                                                            <tr>
                                                                                <td class="text-nowrap">@cita.Fecha.ToString("dd/MM/yyyy")</td>
                                                                                <td class="text-nowrap">@cita.HoraInicio.ToString("h:mm tt", CultureInfo.InvariantCulture) - @cita.HoraFin.ToString("h:mm tt", CultureInfo.InvariantCulture)</td>
                                                                                <td>
                                                                                    @if (!string.IsNullOrWhiteSpace(cita.VehiculoPlaca))
                                                                                    {
                                                                                        <span class="placa-badge placa-badge-sm">@Formatos.Placa(cita.VehiculoPlaca)</span>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <span class="text-secondary">-</span>
                                                                                    }
                                                                                </td>
                                                                                <td>@(cita.ServicioNombre ?? "-")</td>
                                                                                <td style="text-transform:capitalize;">@(cita.MecanicoNombre ?? "-")</td>
                                                                                <td class="text-center">
                                                                                    <span class="badge badge-estado @Formatos.BadgeEstado(cita.Estado)">@Formatos.NombreEstado(cita.Estado)</span>
                                                                                </td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @* ---------- Paginación numerada ---------- *@
    @if (!cargando && totalPaginas > 1)
    {
        <div class="card-footer d-flex flex-wrap justify-content-between align-items-center gap-2">
            <small class="text-muted">
                Página @paginaActual de @totalPaginas — @totalRegistros cliente(s)
            </small>
            <nav aria-label="Paginación de clientes">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                        <button class="page-link" type="button" @onclick="PaginaAnterior">
                            <span aria-hidden="true">&laquo;</span>
                        </button>
                    </li>

                    @if (MostrarElipsisAntes())
                    {
                        <li class="page-item">
                            <button class="page-link" type="button" @onclick="() => IrAPagina(1)">1</button>
                        </li>
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }

                    @foreach (var p in PaginasVisibles())
                    {
                        <li class="page-item @(p == paginaActual ? "active" : "")">
                            <button class="page-link" type="button" @onclick="() => IrAPagina(p)">@p</button>
                        </li>
                    }

                    @if (MostrarElipsisDespues())
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                        <li class="page-item">
                            <button class="page-link" type="button" @onclick="() => IrAPagina(totalPaginas)">@totalPaginas</button>
                        </li>
                    }

                    <li class="page-item @(paginaActual == totalPaginas ? "disabled" : "")">
                        <button class="page-link" type="button" @onclick="PaginaSiguiente">
                            <span aria-hidden="true">&raquo;</span>
                        </button>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

@* ---------- Modal Crear/Editar (solo Administrador) ---------- *@
<AuthorizeView Roles="Administrador" Context="authCtx">
    @if (mostrarModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5);">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <EditForm Model="modelo" OnValidSubmit="Guardar" FormName="clienteForm">
                        <DataAnnotationsValidator />
                        <div class="modal-header">
                            <h5 class="modal-title">
                                @(esEdicion ? "Editar cliente" : "Nuevo cliente")
                            </h5>
                            <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                        </div>
                        <div class="modal-body">
                            @if (!string.IsNullOrEmpty(mensajeError))
                            {
                                <div class="alert alert-danger">@mensajeError</div>
                            }

                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label" for="cliTipoId">Tipo Identificación *</label>
                                    <InputSelect id="cliTipoId" class="form-select" @bind-Value="modelo.TipoIdentificacion">
                                        <option value="@Mecano.Entidad.Constantes.TipoIdentificacion.Nacional">Nacional</option>
                                        <option value="@Mecano.Entidad.Constantes.TipoIdentificacion.Dimex">DIMEX</option>
                                        <option value="@Mecano.Entidad.Constantes.TipoIdentificacion.Pasaporte">Pasaporte</option>
                                    </InputSelect>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label" for="cliCedula">Identificación *</label>
                                    <InputText id="cliCedula" class="form-control" @bind-Value="modelo.CedulaIdentidad" maxlength="20"
                                               placeholder="Número de documento" />
                                    <ValidationMessage For="() => modelo.CedulaIdentidad" class="text-danger small" />
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label" for="cliNombre">Nombre completo *</label>
                                    <InputText id="cliNombre" class="form-control" @bind-Value="modelo.NombreCompleto" autocapitalize="words" maxlength="150" style="text-transform:capitalize;"
                                               placeholder="Nombre y apellidos" />
                                    <ValidationMessage For="() => modelo.NombreCompleto" class="text-danger small" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label" for="cliTelefono">Teléfono *</label>
                                    <InputText id="cliTelefono" class="form-control" @bind-Value="modelo.Telefono" type="tel" inputmode="numeric" maxlength="20"
                                               placeholder="Ej. 88888888" />
                                    <ValidationMessage For="() => modelo.Telefono" class="text-danger small" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label" for="cliCorreo">Correo</label>
                                    <InputText id="cliCorreo" class="form-control" @bind-Value="modelo.Correo" type="email" maxlength="200"
                                               placeholder="cliente@correo.com" />
                                    <ValidationMessage For="() => modelo.Correo" class="text-danger small" />
                                </div>
                            </div>

                            <div class="mb-1">
                                <label class="form-label" for="cliDireccion">Dirección</label>
                                <InputTextArea id="cliDireccion" class="form-control" @bind-Value="modelo.Direccion" maxlength="300"
                                               rows="2" placeholder="Dirección opcional" />
                                <ValidationMessage For="() => modelo.Direccion" class="text-danger small" />
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CerrarModal">
                                Cancelar
                            </button>
                            <button type="submit" class="btn btn-primary" disabled="@guardando">
                                @if (guardando)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                Guardar
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }

    @* ---------- Modal Confirmar Desactivación ---------- *@
    @if (clienteADesactivar is not null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5);">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Confirmar desactivación</h5>
                    </div>
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(mensajeError))
                        {
                            <div class="alert alert-danger">@mensajeError</div>
                        }
                        else
                        {
                            <p>¿Desactivar al cliente <strong style="text-transform:capitalize;">@clienteADesactivar.NombreCompleto</strong>?</p>
                            <p class="text-muted small">
                                El cliente dejará de aparecer en las listas, pero se conserva su historial.
                                Puedes reactivarlo en cualquier momento.
                            </p>
                            @if (citasFuturas > 0)
                            {
                                <p class="text-warning small mb-0">
                                    Este cliente tiene @citasFuturas citas futuras. Seguirán agendadas;
                                    cancelalas manualmente si corresponde.
                                </p>
                            }
                        }
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="CancelarDesactivar">Cancelar</button>
                        <button class="btn btn-warning" @onclick="DesactivarConfirmado" disabled="@guardando">
                            Desactivar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @* ---------- Modal Confirmar Reactivación ---------- *@
    @if (clienteAReactivar is not null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5);">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Confirmar reactivación</h5>
                    </div>
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(mensajeError))
                        {
                            <div class="alert alert-danger">@mensajeError</div>
                        }
                        else
                        {
                            <p>¿Reactivar al cliente <strong style="text-transform:capitalize;">@clienteAReactivar.NombreCompleto</strong>?</p>
                            @if (clienteAReactivar.CantidadVehiculos > 0)
                            {
                                <p class="text-warning small mb-0">
                                    Al reactivar este cliente, TODOS sus vehículos (@clienteAReactivar.CantidadVehiculos)
                                    se reactivarán también.
                                </p>
                            }
                        }
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="CancelarReactivar">Cancelar</button>
                        <button class="btn btn-success" @onclick="ReactivarConfirmado" disabled="@guardando">
                            <i class="bi bi-play-circle"></i> Reactivar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @* ---------- Modal Confirmar Eliminación Definitiva ---------- *@
    @if (clienteAEliminar is not null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5);">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Confirmar eliminación definitiva</h5>
                    </div>
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(mensajeError))
                        {
                            <div class="alert alert-danger">@mensajeError</div>
                        }
                        else
                        {
                            <p>
                                ¿Eliminar permanentemente a <strong style="text-transform:capitalize;">@clienteAEliminar.NombreCompleto</strong>
                                (@Formatos.CedulaNacional(clienteAEliminar.CedulaIdentidad))?
                            </p>
                            <p class="text-muted small mb-0">
                                Esta acción no se puede deshacer. Si solo quieres ocultarlo del listado,
                                usa Desactivar.
                            </p>
                        }
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="CancelarEliminar">Cancelar</button>
                        <button class="btn btn-danger" @onclick="EliminarConfirmado" disabled="@guardando">
                            <span class="bi bi-trash"></span> Eliminar definitivamente
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</AuthorizeView>
