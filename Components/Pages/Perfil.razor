@page "/perfil"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrador")]
@using Mecano.Entidad.DTOs.Perfil
@inject IAdministradorService AdministradorService

<PageTitle>Mi Perfil - Mecano</PageTitle>

@if (cargando)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando…</span>
        </div>
    </div>
}
else if (perfil is null)
{
    <div class="alert alert-danger d-flex align-items-center" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <div>No se pudo cargar tu perfil. Cierra sesión y vuelve a entrar.</div>
    </div>
}
else
{
    @* ---------- Encabezado: avatar con iniciales + rol + identificación ---------- *@
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body d-flex align-items-center gap-3 flex-wrap">
            <div class="perfil-avatar" aria-hidden="true">@Iniciales()</div>
            <div class="flex-grow-1">
                <h1 class="h4 mb-1 text-capitalize">@perfil.Nombre</h1>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis border border-primary-subtle">
                        <i class="bi bi-shield-check me-1"></i>@EtiquetaRol()
                    </span>
                    @if (!string.IsNullOrEmpty(perfil.Cedula))
                    {
                        <span class="text-secondary small">
                            <i class="bi bi-person-vcard me-1"></i>
                            @perfil.TipoIdentificacion · @Formatos.FormatearIdentificacion(perfil.Cedula, perfil.TipoIdentificacion)
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        @* ---------- Información personal y notificaciones ---------- *@
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-bottom d-flex align-items-center gap-2 py-3">
                    <i class="bi bi-person-lines-fill text-primary"></i>
                    <span class="fw-semibold">Información personal</span>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(mensajeExitoPerfil))
                    {
                        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            <div>@mensajeExitoPerfil</div>
                            <button type="button" class="btn-close" @onclick="() => mensajeExitoPerfil = null"></button>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(mensajeErrorPerfil))
                    {
                        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <div>@mensajeErrorPerfil</div>
                            <button type="button" class="btn-close" @onclick="() => mensajeErrorPerfil = null"></button>
                        </div>
                    }

                    <EditForm Model="perfilModel" OnValidSubmit="GuardarPerfil" FormName="perfilForm">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label" for="perfilNombre">Nombre completo</label>
                            <input id="perfilNombre" class="form-control bg-body-secondary text-capitalize" value="@perfil.Nombre" readonly />
                        </div>

                        <div class="row">
                            <div class="col-md-5 mb-3">
                                <label class="form-label" for="perfilTipoId">Tipo de identificación</label>
                                <input id="perfilTipoId" class="form-control bg-body-secondary" value="@perfil.TipoIdentificacion" readonly />
                            </div>
                            <div class="col-md-7 mb-3">
                                <label class="form-label" for="perfilCedula">Identificación</label>
                                <input id="perfilCedula" class="form-control bg-body-secondary"
                                       value="@(string.IsNullOrEmpty(perfil.Cedula) ? "—" : Formatos.FormatearIdentificacion(perfil.Cedula, perfil.TipoIdentificacion))" readonly />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="perfilCorreo">Correo de inicio de sesión</label>
                            <input id="perfilCorreo" class="form-control bg-body-secondary" value="@perfil.Correo" readonly />
                            <div class="form-text">Identifica tu cuenta y no se puede cambiar desde aquí.</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="perfilCorreoNotif">Correo de notificaciones</label>
                            <InputText id="perfilCorreoNotif" class="form-control" type="email" maxlength="200"
                                       autocomplete="off" placeholder="avisos@correo.com"
                                       @bind-Value="perfilModel.CorreoNotificaciones" />
                            <div class="form-text">
                                Recibirás aquí los avisos de tu cuenta. Déjalo vacío para desactivarlos.
                                Debe ser un correo único por administrador.
                            </div>
                            <ValidationMessage For="() => perfilModel.CorreoNotificaciones" class="text-danger small" />
                        </div>

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary d-flex align-items-center gap-2" disabled="@guardandoPerfil">
                                @if (guardandoPerfil)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                }
                                <i class="bi bi-save"></i>
                                <span>Guardar cambios</span>
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>

        @* ---------- Seguridad: cambio de contraseña ---------- *@
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-bottom d-flex align-items-center gap-2 py-3">
                    <i class="bi bi-shield-lock text-primary"></i>
                    <span class="fw-semibold">Seguridad</span>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(mensajeExitoPassword))
                    {
                        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            <div>@mensajeExitoPassword</div>
                            <button type="button" class="btn-close" @onclick="() => mensajeExitoPassword = null"></button>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(mensajeErrorPassword))
                    {
                        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <div>@mensajeErrorPassword</div>
                            <button type="button" class="btn-close" @onclick="() => mensajeErrorPassword = null"></button>
                        </div>
                    }

                    <EditForm Model="passwordModel" OnValidSubmit="GuardarPassword" FormName="passwordForm">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label" for="pwdActual">Contraseña actual</label>
                            <div class="input-group">
                                <InputText id="pwdActual" type="text" class="form-control" @bind-Value="passwordModel.PasswordActual"
                                           autocomplete="off" placeholder="••••••••"
                                           style="@(mostrarPasswordActual ? "-webkit-text-security: none;" : "-webkit-text-security: disc;")" />
                                <button type="button" class="btn btn-outline-secondary" @onclick="TogglePasswordActual"
                                        aria-label="@(mostrarPasswordActual ? "Ocultar contraseña actual" : "Mostrar contraseña actual")">
                                    <i class="@(mostrarPasswordActual ? "bi bi-eye-slash-fill" : "bi bi-eye-fill")"></i>
                                </button>
                            </div>
                            <ValidationMessage For="() => passwordModel.PasswordActual" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="pwdNueva">Nueva contraseña</label>
                            <div class="input-group">
                                <InputText id="pwdNueva" type="text" class="form-control" @bind-Value="passwordModel.NuevaPassword"
                                           autocomplete="off" placeholder="••••••••"
                                           style="@(mostrarPasswordNueva ? "-webkit-text-security: none;" : "-webkit-text-security: disc;")" />
                                <button type="button" class="btn btn-outline-secondary" @onclick="TogglePasswordNueva"
                                        aria-label="@(mostrarPasswordNueva ? "Ocultar nueva contraseña" : "Mostrar nueva contraseña")">
                                    <i class="@(mostrarPasswordNueva ? "bi bi-eye-slash-fill" : "bi bi-eye-fill")"></i>
                                </button>
                            </div>
                            <ValidationMessage For="() => passwordModel.NuevaPassword" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="pwdConfirmar">Confirmar nueva contraseña</label>
                            <div class="input-group">
                                <InputText id="pwdConfirmar" type="text" class="form-control" @bind-Value="passwordModel.ConfirmarPassword"
                                           autocomplete="off" placeholder="••••••••"
                                           style="@(mostrarPasswordConfirmar ? "-webkit-text-security: none;" : "-webkit-text-security: disc;")" />
                                <button type="button" class="btn btn-outline-secondary" @onclick="TogglePasswordConfirmar"
                                        aria-label="@(mostrarPasswordConfirmar ? "Ocultar confirmación" : "Mostrar confirmación")">
                                    <i class="@(mostrarPasswordConfirmar ? "bi bi-eye-slash-fill" : "bi bi-eye-fill")"></i>
                                </button>
                            </div>
                            <ValidationMessage For="() => passwordModel.ConfirmarPassword" class="text-danger small" />
                        </div>

                        <div class="form-text mb-3">
                            Mínimo 6 caracteres, con mayúsculas, minúsculas y números.
                        </div>

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary d-flex align-items-center gap-2" disabled="@guardandoPassword">
                                @if (guardandoPassword)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                }
                                <i class="bi bi-key"></i>
                                <span>Actualizar contraseña</span>
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}
