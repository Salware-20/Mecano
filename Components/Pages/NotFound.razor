@page "/not-found"
@layout MainLayout

<PageTitle>Página no encontrada - Mecano</PageTitle>

<div class="container d-flex align-items-center justify-content-center" style="min-height: 60vh;">
    <div class="text-center p-4">
        <div class="mb-3 text-secondary">
            <i class="bi bi-compass" style="font-size: 4rem;"></i>
        </div>
        <h2 class="fw-bold mb-2">Página no encontrada</h2>
        <p class="text-muted mb-4">La dirección que abriste no existe o fue movida. Revisa el enlace o vuelve al inicio.</p>
        <div class="d-flex gap-2 justify-content-center">
            <a href="/" class="btn btn-primary px-4">Volver al inicio</a>
            <a href="/citas" class="btn btn-outline-secondary px-4">Ver citas</a>
        </div>
    </div>
</div>
