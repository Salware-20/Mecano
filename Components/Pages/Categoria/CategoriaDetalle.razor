@page "/categorias/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrador")]
@using Mecano.Entidad.Constantes
@inject ICategoriaService CategoriaService
@inject IServicioService ServicioService

<PageTitle>@(categoria?.Nombre ?? "Categoría") - Servicios - Mecano</PageTitle>

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="categorias">Categorías</a></li>
        <li class="breadcrumb-item active" aria-current="page">@categoria?.Nombre</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="mb-0"><i class="bi bi-wrench-adjustable"></i> @(categoria?.Nombre ?? "Categoría")</h1>
        @if (!string.IsNullOrWhiteSpace(categoria?.Descripcion))
        {
            <p class="text-muted mb-0">@categoria.Descripcion</p>
        }
        else if (!cargando && categoria is not null)
        {
            <p class="text-muted mb-0">@servicios.Count servicio(s) registrado(s)</p>
        }
    </div>
    <a class="btn btn-outline-secondary" href="categorias">
        <i class="bi bi-arrow-left"></i> Volver
    </a>
</div>

@if (!string.IsNullOrEmpty(mensajeExito))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @mensajeExito
        <button type="button" class="btn-close" @onclick="() => mensajeExito = null" aria-label="Cerrar"></button>
    </div>
}
@if (!string.IsNullOrEmpty(mensajeError) && !HayModalAbierto)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @mensajeError
        <button type="button" class="btn-close" @onclick="() => mensajeError = null" aria-label="Cerrar"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-header">
        <div class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" placeholder="Buscar servicio..."
                           aria-label="Buscar servicios"
                           value="@terminoBusqueda" @oninput="OnBuscarCambio" />
                    @if (!string.IsNullOrEmpty(terminoBusqueda))
                    {
                        <button class="btn btn-outline-secondary" type="button" title="Limpiar búsqueda"
                                @onclick="LimpiarBusqueda">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    }
                </div>
            </div>
            <div class="col-md-3">
                <div class="d-flex align-items-center gap-2">
                    <label class="form-label mb-0 text-nowrap" for="selServiciosEstado">Estado</label>
                    <select id="selServiciosEstado" class="form-select form-select-sm"
                            value="@filtro" @onchange="CambiarFiltro">
                        <option value="@FiltroActivo.Activos">Activos</option>
                        <option value="@FiltroActivo.Inactivos">Inactivos</option>
                        <option value="@FiltroActivo.Todos">Todos</option>
                    </select>
                </div>
            </div>
            <div class="col-md-4 d-grid d-md-flex justify-content-md-end">
                <button class="btn btn-primary" @onclick="AbrirCrear">
                    <i class="bi bi-plus-circle"></i> Nuevo servicio
                </button>
            </div>
        </div>
    </div>

    <div class="card-body">
        @if (cargando)
        {
            <div class="text-center py-4">
                <div class="spinner-border" role="status"><span class="visually-hidden">Cargando...</span></div>
            </div>
        }
        else if (categoria is null)
        {
            <div class="alert alert-warning mb-0 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span>La categoría no existe o fue eliminada.</span>
                <a class="btn btn-sm btn-outline-secondary" href="categorias">Volver a categorías</a>
            </div>
        }
        else if (!ServiciosVisibles.Any())
        {
            <div class="alert alert-info mb-0 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span>@TextoVacio()</span>
                @if (servicios.Count == 0)
                {
                    <button class="btn btn-sm btn-primary" @onclick="AbrirCrear">
                        <i class="bi bi-plus-circle"></i> Nuevo servicio
                    </button>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th class="text-center">Duración</th>
                            <th class="text-end">Precio</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in ServiciosVisibles)
                        {
                            <tr class="@(s.Activo ? "" : "table-secondary")">
                                <td class="fw-semibold">@s.Nombre</td>
                                <td>@(string.IsNullOrWhiteSpace(s.Descripcion) ? "-" : s.Descripcion)</td>
                                <td class="text-center">@Formatos.Duracion(s.DuracionMinutos)</td>
                                <td class="text-end">@Formatos.Moneda(s.Precio)</td>
                                <td class="text-center">
                                    @if (s.Activo)
                                    {
                                        <span class="badge badge-status-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-status-neutral">Inactivo</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary me-1" title="Editar"
                                            @onclick="() => AbrirEditar(s)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    @if (s.Activo)
                                    {
                                        <button class="btn btn-sm btn-outline-warning" title="Desactivar servicio"
                                                aria-label="Desactivar @s.Nombre"
                                                @onclick="() => ConfirmarDesactivar(s)">
                                            <i class="bi bi-pause-circle"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-success" title="Reactivar servicio"
                                                aria-label="Reactivar @s.Nombre"
                                                @onclick="() => ConfirmarReactivar(s)">
                                            <i class="bi bi-play-circle"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* ---------- Modal Crear/Editar ---------- *@
@if (mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <EditForm Model="modelo" OnValidSubmit="Guardar" FormName="servicioForm">
                    <DataAnnotationsValidator />
                    <div class="modal-header">
                        <h5 class="modal-title">
                            @(esEdicion ? "Editar servicio" : "Nuevo servicio")
                        </h5>
                        <button type="button" class="btn-close" @onclick="CerrarModal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(mensajeError))
                        {
                            <div class="alert alert-danger">@mensajeError</div>
                        }

                        <div class="mb-3">
                            <label class="form-label" for="servNombre">Nombre *</label>
                            <InputText id="servNombre" class="form-control" @bind-Value="modelo.Nombre"
                                       autocomplete="off" style="text-transform:capitalize;" placeholder="Descripción breve del servicio (ej. Cambio de pastillas de freno)" />
                            <ValidationMessage For="() => modelo.Nombre" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="servDescripcion">Descripción</label>
                            <InputTextArea id="servDescripcion" class="form-control" @bind-Value="modelo.Descripcion"
                                           rows="3" placeholder="Detalle opcional del servicio" />
                            <ValidationMessage For="() => modelo.Descripcion" class="text-danger small" />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="servDuracion">Duración (minutos) *</label>
                                <InputNumber id="servDuracion" class="form-control" @bind-Value="modelo.DuracionMinutos"
                                             @oninput="OnDuracionInput" />
                                <ValidationMessage For="() => modelo.DuracionMinutos" class="text-danger small" />
                                <small class="text-muted">
                                    Entre 5 y 480 minutos. Equivale a <strong>@Formatos.Duracion(modelo.DuracionMinutos)</strong>.
                                </small>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="servPrecio">Precio *</label>
                                <InputNumber id="servPrecio" class="form-control" @bind-Value="modelo.Precio" />
                                <ValidationMessage For="() => modelo.Precio" class="text-danger small" />
                                <small class="text-muted">
                                    Se mostrará como <strong>@Formatos.Moneda(modelo.Precio)</strong>
                                    (colones, 2 decimales).
                                </small>
                            </div>
                        </div>

                        <div class="mb-1">
                            <label class="form-label" for="servCategoria">Categoría</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-tag"></i></span>
                                <input id="servCategoria" type="text" class="form-control"
                                       value="@(categoria?.Nombre ?? "-")" disabled />
                            </div>
                            <small class="text-muted">El servicio queda asignado a esta categoría.</small>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CerrarModal">
                            Cancelar
                        </button>
                        <button type="submit" class="btn btn-primary" disabled="@guardando">
                            @if (guardando)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Guardar
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@* ---------- Modal Confirmar Desactivación ---------- *@
@if (servicioADesactivar is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Desactivar servicio</h5>
                    <button type="button" class="btn-close" @onclick="CancelarDesactivar" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(mensajeError))
                    {
                        <div class="alert alert-danger">@mensajeError</div>
                    }
                    else
                    {
                        <p>¿Desactivar el servicio <strong>@servicioADesactivar.Nombre</strong>?</p>
                        <p class="text-muted small mb-0">
                            El servicio dejará de aparecer al agendar citas. Las citas ya registradas se conservan
                            y podrás reactivarlo en cualquier momento.
                        </p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelarDesactivar">Cancelar</button>
                    <button type="button" class="btn btn-warning" @onclick="DesactivarConfirmado" disabled="@guardando">
                        Desactivar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ---------- Modal Confirmar Reactivación ---------- *@
@if (servicioAReactivar is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Reactivar servicio</h5>
                    <button type="button" class="btn-close" @onclick="CancelarReactivar" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(mensajeError))
                    {
                        <div class="alert alert-danger">@mensajeError</div>
                    }
                    else
                    {
                        <p>¿Reactivar el servicio <strong>@servicioAReactivar.Nombre</strong>?</p>
                        <p class="text-muted small mb-0">
                            El servicio volverá a estar disponible para agendar citas.
                        </p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelarReactivar">Cancelar</button>
                    <button type="button" class="btn btn-success" @onclick="ReactivarConfirmado" disabled="@guardando">
                        Reactivar
                    </button>
                </div>
            </div>
        </div>
    </div>
}
