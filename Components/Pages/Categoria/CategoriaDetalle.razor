@page "/categorias/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrador")]
@inject ICategoriaService CategoriaService
@inject IServicioService ServicioService

<PageTitle>@(categoria?.Nombre ?? "Categoría") - Servicios - Mecano</PageTitle>

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="categorias">Categorías</a></li>
        <li class="breadcrumb-item active" aria-current="page">@categoria?.Nombre</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-1"><i class="bi bi-wrench-adjustable"></i> @(categoria?.Nombre ?? "Categoría")</h1>
        @if (!string.IsNullOrWhiteSpace(categoria?.Descripcion))
        {
            <p class="text-muted mb-0">@categoria.Descripcion</p>
        }
        <small class="text-muted">@servicios.Count servicio(s) registrado(s)</small>
    </div>
    <a class="btn btn-outline-secondary" href="categorias">
        <i class="bi bi-arrow-left"></i> Volver
    </a>
</div>

@if (!string.IsNullOrEmpty(mensajeExito))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @mensajeExito
        <button type="button" class="btn-close" @onclick="() => mensajeExito = null"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" id="chkInactivos"
                   @bind="mostrarInactivos" @bind:after="CargarAsync" />
            <label class="form-check-label" for="chkInactivos">Mostrar inactivos</label>
        </div>
        <button class="btn btn-primary" @onclick="AbrirCrear">
            <i class="bi bi-plus-circle"></i> Nuevo servicio
        </button>
    </div>
    <div class="card-body">
        @if (cargando)
        {
            <div class="text-center py-4">
                <div class="spinner-border" role="status"></div>
            </div>
        }
        else if (categoria is null)
        {
            <div class="alert alert-warning mb-0">La categoría no existe o fue eliminada.</div>
        }
        else if (!servicios.Any())
        {
            <div class="alert alert-info mb-0">
                @(mostrarInactivos
                    ? "Esta categoría no tiene servicios registrados."
                    : "Esta categoría no tiene servicios activos. Use “Mostrar inactivos” para ver los desactivados.")
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th class="text-center">Duración</th>
                            <th class="text-end">Precio</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in servicios)
                        {
                            <tr class="@(s.Activo ? "" : "table-secondary")">
                                <td><strong>@s.Nombre</strong></td>
                                <td class="text-muted">@s.Descripcion</td>
                                <td class="text-center">@s.DuracionMinutos min</td>
                                <td class="text-end">@Formatos.Moneda(s.Precio)</td>
                                <td class="text-center">
                                    @if (s.Activo)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactivo</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (s.Activo)
                                    {
                                        <button class="btn btn-sm btn-outline-primary me-1"
                                                @onclick="() => AbrirEditar(s)">
                                            <i class="bi bi-pencil"></i> Editar
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => ConfirmarEliminar(s)">
                                            <i class="bi bi-trash"></i> Eliminar
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-success"
                                                @onclick="() => Reactivar(s)" disabled="@guardando">
                                            <i class="bi bi-arrow-counterclockwise"></i> Reactivar
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* ---------- Modal Crear/Editar ---------- *@
@if (mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <EditForm Model="modelo" OnValidSubmit="Guardar" FormName="servicioForm">
                    <DataAnnotationsValidator />
                    <div class="modal-header">
                        <h5 class="modal-title">
                            @(esEdicion ? "Editar servicio" : "Nuevo servicio")
                        </h5>
                        <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                    </div>
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(mensajeError))
                        {
                            <div class="alert alert-danger">@mensajeError</div>
                        }

                        <div class="mb-3">
                            <label class="form-label" for="servNombre">Nombre *</label>
                            <InputText id="servNombre" class="form-control" @bind-Value="modelo.Nombre"
                                       placeholder="Ej. Cambio de pastillas de freno" />
                            <ValidationMessage For="() => modelo.Nombre" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="servDescripcion">Descripción</label>
                            <InputTextArea id="servDescripcion" class="form-control" @bind-Value="modelo.Descripcion"
                                           rows="3" placeholder="Detalle opcional del servicio" />
                            <ValidationMessage For="() => modelo.Descripcion" class="text-danger small" />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="servDuracion">Duración (minutos) *</label>
                                <InputNumber id="servDuracion" class="form-control" @bind-Value="modelo.DuracionMinutos"
                                             min="5" max="480" step="5" />
                                <ValidationMessage For="() => modelo.DuracionMinutos" class="text-danger small" />
                                <small class="text-muted">Entre 5 y 480 minutos.</small>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="servPrecio">Precio *</label>
                                <InputNumber id="servPrecio" class="form-control" @bind-Value="modelo.Precio"
                                             min="0" step="0.01" />
                                <ValidationMessage For="() => modelo.Precio" class="text-danger small" />
                                <small class="text-muted">
                                    Se mostrará como <strong>@Formatos.Moneda(modelo.Precio)</strong>
                                    (colones, 2 decimales).
                                </small>
                            </div>
                        </div>

                        <div class="mb-1">
                            <label class="form-label" for="servCategoria">Categoría</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-tag"></i></span>
                                <input id="servCategoria" type="text" class="form-control"
                                       value="@(categoria?.Nombre ?? "-")" disabled />
                            </div>
                            <small class="text-muted">El servicio queda asignado a esta categoría.</small>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CerrarModal">
                            Cancelar
                        </button>
                        <button type="submit" class="btn btn-primary" disabled="@guardando">
                            @if (guardando)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Guardar
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@* ---------- Modal Confirmar Eliminación ---------- *@
@if (servicioAEliminar is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Desactivar servicio</h5>
                    <button type="button" class="btn-close" @onclick="CancelarEliminar"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(mensajeError))
                    {
                        <div class="alert alert-danger">@mensajeError</div>
                    }
                    else
                    {
                        <p>¿Desactivar el servicio <strong>@servicioAEliminar.Nombre</strong>?</p>
                        <p class="text-muted small mb-0">
                            El servicio dejará de aparecer al agendar citas. Las citas ya registradas se conservan
                            y podrás reactivarlo en cualquier momento.
                        </p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelarEliminar">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="EliminarConfirmado" disabled="@guardando">
                        Desactivar
                    </button>
                </div>
            </div>
        </div>
    </div>
}
