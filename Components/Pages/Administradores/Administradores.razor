@page "/administradores"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "AdminGlobal")]
@using Mecano.Entidad.Constantes
@using Mecano.Entidad.DTOs.Administrador
@using Mecano.Entidad.Utilidades

<PageTitle>Administradores - Mecano</PageTitle>

<h1><i class="bi bi-shield-lock"></i> Gestión de Administradores</h1>

@if (!string.IsNullOrEmpty(mensajeExito))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @mensajeExito
        <button type="button" class="btn-close" aria-label="Cerrar" @onclick="() => mensajeExito = null"></button>
    </div>
}
@if (!string.IsNullOrEmpty(mensajeErrorPagina))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @mensajeErrorPagina
        <button type="button" class="btn-close" aria-label="Cerrar" @onclick="() => mensajeErrorPagina = null"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-header">
        <div class="row g-2 align-items-center">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" placeholder="Buscar por nombre, correo o cédula..."
                           value="@terminoBusqueda" @oninput="OnBuscarCambio" />
                    @if (!string.IsNullOrEmpty(terminoBusqueda))
                    {
                        <button class="btn btn-outline-secondary" type="button" @onclick="LimpiarBusqueda">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    }
                </div>
            </div>
            <div class="col-md-3">
                <select class="form-select form-select-sm" value="@filtroEstado" @onchange="CambiarFiltro">
                    <option value="todos">Todos</option>
                    <option value="activos">Activos</option>
                    <option value="inactivos">Inactivos</option>
                </select>
            </div>
            <div class="col-md-3 text-md-end">
                <button class="btn btn-primary w-100" @onclick="AbrirCrear">
                    <i class="bi bi-plus-circle"></i> Nuevo administrador
                </button>
            </div>
        </div>
    </div>

    <div class="card-body">
        @if (cargando)
        {
            <div class="text-center py-4">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
            </div>
        }
        else if (!AdministradoresFiltrados.Any())
        {
            <div class="alert alert-info mb-0">No hay administradores para mostrar.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Email</th>
                            <th>Identificación</th>
                            <th>Teléfono</th>
                            <th class="text-center">Tipo</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var admin in AdministradoresFiltrados)
                        {
                            <tr class="@(!admin.Activo ? "table-secondary" : "")">
                                <td style="text-transform:capitalize;"><strong>@admin.Nombre</strong></td>
                                <td>@admin.Email</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(admin.Cedula))
                                    {
                                        <span>@Formatos.FormatearIdentificacion(admin.Cedula, admin.TipoIdentificacion)</span>
                                        <small class="text-muted d-block">@admin.TipoIdentificacion</small>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(admin.Telefono) ? "—" : admin.Telefono)</td>
                                <td class="text-center">
                                    @if (admin.EsAdminGlobal)
                                    {
                                        <span class="badge bg-warning text-dark">Dueño</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-dark">Staff</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (admin.Activo)
                                    {
                                        <span class="badge badge-status-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-status-neutral">Inactivo</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary me-1" title="Editar" @onclick="() => AbrirEditar(admin)" disabled="@guardando">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    @if (!admin.EsAdminGlobal && admin.AdministradorId != adminActualId)
                                    {
                                        @if (admin.Activo)
                                        {
                                            <button class="btn btn-sm btn-outline-warning me-1" title="Desactivar" @onclick="() => ConfirmarDesactivar(admin)" disabled="@guardando">
                                                <i class="bi bi-pause-circle"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-success me-1" title="Reactivar" @onclick="() => ConfirmarReactivar(admin)" disabled="@guardando">
                                                <i class="bi bi-play-circle"></i>
                                            </button>
                                        }
                                        <button class="btn btn-sm btn-outline-danger" title="Eliminar" @onclick="() => ConfirmarEliminar(admin)" disabled="@guardando">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5);">
        <div class="modal-dialog modal-lg">
            @if (esEdicion)
            {
                <div class="modal-content">
                    <EditForm Model="modelo" OnValidSubmit="Guardar" FormName="adminEditForm">
                        <DataAnnotationsValidator />
                        <div class="modal-header">
                            <h5 class="modal-title">Editar administrador</h5>
                            <button type="button" class="btn-close" aria-label="Cerrar" @onclick="CerrarModal"></button>
                        </div>
                        <div class="modal-body">
                            @if (!string.IsNullOrEmpty(mensajeError))
                            {
                                <div class="alert alert-danger">@mensajeError</div>
                            }

                            <div class="mb-3">
                                <label class="form-label">Nombre *</label>
                                <InputText class="form-control" @bind-Value="modelo.Nombre" maxlength="150" style="text-transform:capitalize;" />
                                <ValidationMessage For="() => modelo.Nombre" class="text-danger small" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Correo de inicio de sesión</label>
                                <input class="form-control" value="@adminEmailActual" disabled readonly />
                                <div class="form-text">No se puede modificar desde esta pantalla. El correo de notificaciones se configura en Mi Perfil.</div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label">Tipo Identificación</label>
                                    <InputSelect class="form-select" @bind-Value="modelo.TipoIdentificacion">
                                        <option value="@TipoIdentificacion.Nacional">Nacional</option>
                                        <option value="@TipoIdentificacion.Dimex">DIMEX</option>
                                        <option value="@TipoIdentificacion.Pasaporte">Pasaporte</option>
                                    </InputSelect>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label">Identificación</label>
                                    <InputText class="form-control" @bind-Value="modelo.Cedula" maxlength="20" />
                                    <ValidationMessage For="() => modelo.Cedula" class="text-danger small" />
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label">Teléfono</label>
                                    <InputText class="form-control" @bind-Value="modelo.Telefono" maxlength="20" />
                                    <ValidationMessage For="() => modelo.Telefono" class="text-danger small" />
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@guardando">
                                @if (guardando)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                Guardar
                            </button>
                        </div>
                    </EditForm>
                </div>
            }
            else
            {
                <div class="modal-content">
                    <EditForm Model="crearModelo" OnValidSubmit="Guardar" FormName="adminCreateForm">
                        <DataAnnotationsValidator />
                        <div class="modal-header">
                            <h5 class="modal-title">Nuevo administrador</h5>
                            <button type="button" class="btn-close" aria-label="Cerrar" @onclick="CerrarModal"></button>
                        </div>
                        <div class="modal-body">
                            @if (!string.IsNullOrEmpty(mensajeError))
                            {
                                <div class="alert alert-danger">@mensajeError</div>
                            }

                            <div class="mb-3">
                                <label class="form-label">Nombre *</label>
                                <InputText class="form-control" @bind-Value="crearModelo.Nombre" maxlength="150" style="text-transform:capitalize;" />
                                <ValidationMessage For="() => crearModelo.Nombre" class="text-danger small" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="adminAliasCorreo">Usuario corporativo *</label>
                                <div class="input-group">
                                    <InputText id="adminAliasCorreo" class="form-control" @bind-Value="crearModelo.AliasCorreo"
                                               maxlength="@CorreoCorporativo.LargoMaximoAlias" autocomplete="off" autocapitalize="none" spellcheck="false"
                                               aria-describedby="adminAliasCorreoHelp" />
                                    <span class="input-group-text">@CorreoCorporativo.Dominio</span>
                                </div>
                                <ValidationMessage For="() => crearModelo.AliasCorreo" class="text-danger small" />
                                <div id="adminAliasCorreoHelp" class="form-text">
                                    Solo el alias; el dominio @CorreoCorporativo.Dominio es fijo. No incluyas @@, espacios ni dominios externos.
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label">Tipo Identificación</label>
                                    <InputSelect class="form-select" @bind-Value="crearModelo.TipoIdentificacion">
                                        <option value="@TipoIdentificacion.Nacional">Nacional</option>
                                        <option value="@TipoIdentificacion.Dimex">DIMEX</option>
                                        <option value="@TipoIdentificacion.Pasaporte">Pasaporte</option>
                                    </InputSelect>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label">Identificación</label>
                                    <InputText class="form-control" @bind-Value="crearModelo.Cedula" maxlength="20" />
                                    <ValidationMessage For="() => crearModelo.Cedula" class="text-danger small" />
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label">Teléfono</label>
                                    <InputText class="form-control" @bind-Value="crearModelo.Telefono" maxlength="20" />
                                    <ValidationMessage For="() => crearModelo.Telefono" class="text-danger small" />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Contraseña *</label>
                                    <InputText type="password" class="form-control" autocomplete="new-password" @bind-Value="crearModelo.Password" />
                                    <ValidationMessage For="() => crearModelo.Password" class="text-danger small" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Confirmar contraseña *</label>
                                    <InputText type="password" class="form-control" autocomplete="new-password" @bind-Value="crearModelo.ConfirmarPassword" />
                                    <ValidationMessage For="() => crearModelo.ConfirmarPassword" class="text-danger small" />
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@guardando">
                                @if (guardando)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                Guardar
                            </button>
                        </div>
                    </EditForm>
                </div>
            }
        </div>
    </div>
}

@if (adminADesactivar is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar desactivación</h5>
                    <button type="button" class="btn-close" aria-label="Cerrar" @onclick="CancelarDesactivar"></button>
                </div>
                <div class="modal-body">
                    <p>¿Desactivar al administrador <strong style="text-transform:capitalize;">@adminADesactivar.Nombre</strong>?</p>
                    <p class="text-muted small mb-0">No podrá iniciar sesión hasta que sea reactivado.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelarDesactivar">Cancelar</button>
                    <button class="btn btn-warning" @onclick="DesactivarConfirmado" disabled="@guardando">
                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Desactivar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (adminAReactivar is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar reactivación</h5>
                    <button type="button" class="btn-close" aria-label="Cerrar" @onclick="CancelarReactivar"></button>
                </div>
                <div class="modal-body">
                    <p>¿Reactivar al administrador <strong style="text-transform:capitalize;">@adminAReactivar.Nombre</strong>?</p>
                    <p class="text-muted small mb-0">Podrá iniciar sesión nuevamente.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelarReactivar">Cancelar</button>
                    <button class="btn btn-success" @onclick="ReactivarConfirmado" disabled="@guardando">
                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Reactivar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (adminAEliminar is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-danger"><i class="bi bi-exclamation-triangle"></i> Confirmar eliminación</h5>
                    <button type="button" class="btn-close" aria-label="Cerrar" @onclick="CancelarEliminar"></button>
                </div>
                <div class="modal-body">
                    <p>¿Está seguro de que desea eliminar permanentemente al administrador <strong style="text-transform:capitalize;">@adminAEliminar.Nombre</strong> (@adminAEliminar.Email)?</p>
                    <p class="text-danger small mb-0">Esta acción no se puede deshacer. Solo se permitirá si no tiene auditorías registradas en el sistema.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelarEliminar">Cancelar</button>
                    <button class="btn btn-danger" @onclick="EliminarConfirmado" disabled="@guardando">
                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Eliminar
                    </button>
                </div>
            </div>
        </div>
    </div>
}
