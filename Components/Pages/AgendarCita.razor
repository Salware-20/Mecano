@page "/agendar"
@attribute [Authorize(Roles = Mecano.Entidad.Constantes.Roles.Administrador)]
@rendermode InteractiveServer
@implements IDisposable
@using System.Globalization
@using Mecano.Entidad.Constantes
@using MecanicoDTO = Mecano.Entidad.DTOs.Mecanico.MecanicoDTO
@inject IClienteService ClienteService
@inject IVehiculoService VehiculoService
@inject IServicioService ServicioService
@inject IMecanicoService MecanicoService
@inject ICitaService CitaService
@inject INotificationService NotificationService
@inject NavigationManager Nav

<PageTitle>Agendar Cita</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h2 class="mb-0"><i class="bi bi-calendar-plus"></i> Agendar Cita</h2>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <!-- Búsqueda de cliente -->
    <div class="row mb-4">
        <div class="col-md-6">
            @if (selectedCliente == null)
            {
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Buscar Cliente</h5>
                        <div class="input-group mb-3">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="text" class="form-control" placeholder="Cédula, nombre o correo..."
                                   @bind="searchTerm" @bind:event="oninput" @onkeyup="HandleSearch" />
                        </div>

                        @if (isSearching)
                        {
                            <div class="text-center">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Buscando...</span>
                                </div>
                            </div>
                        }
                        else if (clientesEncontrados != null && clientesEncontrados.Any())
                        {
                            <ul class="list-group">
                                @foreach (var c in clientesEncontrados)
                                {
                                    <li class="list-group-item list-group-item-action cursor-pointer @(c.Activo ? "" : "list-group-item-secondary")" @onclick="() => SelectCliente(c)">
                                        <strong style="text-transform:capitalize;">@c.NombreCompleto</strong>
                                        @if (!c.Activo)
                                        {
                                            <span class="badge bg-secondary ms-1">Inactivo</span>
                                        }
                                        - @Formatos.CedulaNacional(c.CedulaIdentidad)<br />
                                        <small class="text-muted">@Formatos.Telefono(c.Telefono) | @c.Correo</small>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="card @(selectedCliente.Activo ? "border-success" : "border-warning") shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="card-title @(selectedCliente.Activo ? "text-success" : "text-warning-emphasis")">
                                    <i class="bi @(selectedCliente.Activo ? "bi-person-check" : "bi-person-exclamation")"></i> Cliente Seleccionado
                                </h5>
                                <strong style="text-transform:capitalize;">@selectedCliente.NombreCompleto</strong>
                                @if (!selectedCliente.Activo)
                                {
                                    <span class="badge bg-secondary ms-1">Inactivo</span>
                                }
                                (@Formatos.CedulaNacional(selectedCliente.CedulaIdentidad))<br />
                                <small>@Formatos.Telefono(selectedCliente.Telefono) | @selectedCliente.Correo</small>
                                @if (!selectedCliente.Activo)
                                {
                                    <div class="text-warning-emphasis small mt-1">
                                        <i class="bi bi-exclamation-triangle"></i> Cliente inactivo. Se permite agendar, pero verifique su estado.
                                    </div>
                                }
                            </div>
                            <button class="btn btn-outline-secondary btn-sm" @onclick="DeselectCliente">Cambiar</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Tablero de mecánicos (una fila por mecánico, una columna por día) -->
    <div class="tablero-card card shadow-sm">
        <div class="tablero-toolbar">
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="SemanaAnterior"
                        disabled="@(!PuedeRetroceder)" title="Semana anterior" aria-label="Semana anterior">
                    <i class="bi bi-chevron-left"></i>
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="IrHoy" disabled="@EsSemanaActual">
                    Hoy
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="SemanaSiguiente"
                        title="Semana siguiente" aria-label="Semana siguiente">
                    <i class="bi bi-chevron-right"></i>
                </button>
                <span class="tablero-rango">@EtiquetaSemana</span>
            </div>
            <div class="text-secondary small d-none d-sm-block">
                <i class="bi bi-clock"></i> Lun–Sáb · 8:00 a. m. – 6:00 p. m.
            </div>
        </div>

        @if (selectedCliente == null)
        {
            <div class="tablero-aviso">
                <i class="bi bi-person-badge"></i> Seleccione un cliente para agendar una cita.
            </div>
        }

        @if (cargando)
        {
            <div class="tablero-cargando">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
            </div>
        }
        else if (!mecanicos.Any())
        {
            <div class="tablero-vacio">
                <i class="bi bi-wrench-adjustable"></i>
                <p class="mb-0">No hay mecánicos activos registrados.</p>
            </div>
        }
        else
        {
            <div class="tablero-scroll @(selectedCliente == null ? "tablero-bloqueado" : "")">
                <table class="tablero">
                    <thead>
                        <tr>
                            <th class="col-mecanico tablero-esquina">Mecánico</th>
                            @foreach (var dia in DiasSemana)
                            {
                                <th class="@ClaseCabeceraDia(dia)">
                                    <span class="dia-nombre">@dia.ToString("ddd", EsCr)</span>
                                    <span class="dia-numero">@dia.Day</span>
                                    @if (dia.Date == hoy)
                                    {
                                        <span class="dia-hoy-badge">Hoy</span>
                                    }
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in mecanicos)
                        {
                            <tr class="@(!m.Activo ? "tablero-mecanico-inactivo" : null)">
                                <th class="col-mecanico tablero-mecanico">
                                    <span class="mecanico-nombre" style="text-transform:capitalize;">@m.Nombre</span>
                                    @if (!m.Activo)
                                    {
                                        <span class="badge bg-secondary ms-1">Inactivo</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(m.EspecialidadNombre))
                                    {
                                        <span class="mecanico-especialidad">@m.EspecialidadNombre</span>
                                    }
                                </th>
                                @foreach (var dia in DiasSemana)
                                {
                                    <td class="@ClaseCelda(m, dia)" @onclick="() => AbrirModal(m, dia)">
                                        @foreach (var c in CitasDe(m.Id, dia))
                                        {
                                            <div class="chip chip-@CssEstado(c.Estado)"
                                                 title="@TituloChip(c)"
                                                 @onclick="() => IrACita(c.CitaId)"
                                                 @onclick:stopPropagation="true">
                                                <span class="chip-hora">@c.HoraInicio.ToString("h:mm tt", CultureInfo.InvariantCulture)</span>
                                                <span class="chip-cuerpo">
                                                    <span class="chip-cliente" style="text-transform:capitalize;">
                                                        @if (c.Cliente?.Activo == false)
                                                        {
                                                            <i class="bi bi-exclamation-circle chip-cliente-inactivo" aria-hidden="true"></i>
                                                        }
                                                        @c.Cliente?.NombreCompleto
                                                    </span>
                                                    <span class="chip-servicio">@c.Servicio?.Nombre</span>
                                                </span>
                                            </div>
                                        }
                                        @if (PuedeAgendar(dia) && m.Activo)
                                        {
                                            <span class="celda-agregar">
                                                <i class="bi bi-plus-lg"></i> Agendar
                                            </span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <!-- Leyenda de estados de cita -->
        <div class="tablero-leyenda" role="list" aria-label="Leyenda de estados de cita">
            <span class="leyenda-titulo">Estados:</span>
            <span class="leyenda-item" role="listitem"><span class="leyenda-swatch chip-pendiente"></span> Pendiente</span>
            <span class="leyenda-item" role="listitem"><span class="leyenda-swatch chip-confirmado"></span> Confirmado</span>
            <span class="leyenda-item" role="listitem"><span class="leyenda-swatch chip-proceso"></span> En Proceso</span>
            <span class="leyenda-item" role="listitem"><span class="leyenda-swatch chip-finalizado"></span> Finalizado</span>
            <span class="leyenda-item" role="listitem"><span class="leyenda-swatch chip-cancelado"></span> Cancelado</span>
        </div>
    </div>
</div>

<!-- Modal Agendar Cita -->
@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Agendar Nueva Cita</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <div class="resumen-cita mb-3">
                        <div><i class="bi bi-person-check"></i> <strong style="text-transform:capitalize;">@selectedCliente?.NombreCompleto</strong></div>
                        <div class="text-secondary"><i class="bi bi-calendar-event"></i> @selectedFecha.ToString("dddd dd 'de' MMMM 'de' yyyy", EsCr)</div>
                        <div class="text-secondary">
                            <i class="bi bi-wrench-adjustable"></i>
                            @if (selMecanicosIds.Any())
                            {
                                <span style="text-transform:capitalize;">@MecanicosSeleccionadosNombres</span>
                            }
                            else
                            {
                                <span>Seleccione al menos un mecánico</span>
                            }
                        </div>
                    </div>

                    @if (selectedCliente is { Activo: false })
                    {
                        <div class="alert alert-warning d-flex align-items-center py-2 mb-3" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            <div>El cliente seleccionado está inactivo. La cita se puede agendar, pero revise su estado.</div>
                        </div>
                    }

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label mb-1">
                                Mecánicos
                                <span class="text-muted small">(puede elegir varios de la misma especialidad)</span>
                            </label>
                            <div class="lista-mecanicos">
                                @foreach (var grupo in MecanicosPorEspecialidad)
                                {
                                    var habilitado = GrupoHabilitado(grupo.Key);
                                    <div class="grupo-mecanicos @(habilitado ? "" : "grupo-mecanicos-deshabilitado")">
                                        <div class="grupo-mecanicos-titulo">
                                            @(string.IsNullOrWhiteSpace(grupo.First().EspecialidadNombre) ? "Sin especialidad" : grupo.First().EspecialidadNombre)
                                            @if (!habilitado)
                                            {
                                                <span class="text-muted small">&#32;— misma especialidad requerida</span>
                                            }
                                        </div>
                                        <div class="d-flex flex-wrap gap-3">
                                            @foreach (var m in grupo)
                                            {
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" id="mec-@m.Id"
                                                           checked="@selMecanicosIds.Contains(m.Id)"
                                                           disabled="@(!habilitado)"
                                                           @onchange="e => ToggleMecanico(m.Id, e)" />
                                                    <label class="form-check-label" for="mec-@m.Id" style="text-transform:capitalize;">@m.Nombre</label>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                            @if (!selMecanicosIds.Any())
                            {
                                <div class="form-text text-danger">Seleccione al menos un mecánico.</div>
                            }
                        </div>

                        <div class="col-md-6">
                            <label class="form-label" for="servicio">Servicio</label>
                            <select id="servicio" class="form-select" value="@citaDto.ServicioId" @onchange="OnServiceChanged"
                                    disabled="@(!selMecanicosIds.Any() || !serviciosDelMecanico.Any())">
                                <option value="0">Seleccione un servicio...</option>
                                @foreach (var s in serviciosDelMecanico)
                                {
                                    <option value="@s.ServicioId">@s.Nombre (@Formatos.Moneda(s.Precio))</option>
                                }
                            </select>
                            @if (selMecanicosIds.Any() && !serviciosDelMecanico.Any())
                            {
                                <div class="form-text text-danger">Esta especialidad no tiene servicios asociados.</div>
                            }
                        </div>

                        <div class="col-md-6">
                            <label class="form-label" for="hora-inicio">Hora de inicio</label>
                            <select id="hora-inicio" class="form-select" value="@selHora.ToString("HH:mm")" @onchange="OnHoraChanged">
                                @foreach (var h in HorasDelDia)
                                {
                                    <option value="@h.ToString("HH:mm")" disabled="@(!HoraHabilitada(h))">
                                        @h.ToString("h:mm tt", CultureInfo.InvariantCulture)
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Fin estimado</label>
                            <div class="form-control-plaintext">
                                @if (selectedServicio != null)
                                {
                                    <span>@selectedHoraFin.ToString("h:mm tt", CultureInfo.InvariantCulture)</span>
                                    <span class="text-secondary"> · @selectedServicio.DuracionMinutos min</span>
                                }
                                else
                                {
                                    <span class="text-secondary">Seleccione un servicio</span>
                                }
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label" for="vehiculo">Vehículo</label>
                            <select id="vehiculo" class="form-select" value="@citaDto.VehiculoId" @onchange="OnVehiculoChanged">
                                <option value="">Seleccione un vehículo...</option>
                                @if (vehiculosCliente != null)
                                {
                                    @foreach (var v in vehiculosCliente)
                                    {
                                        <option value="@v.VehiculoId">@Formatos.Placa(v.Placa) - @v.Marca @v.Modelo</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(modalError))
                    {
                        <div class="alert alert-danger mt-3 mb-0 py-2" role="alert">
                            <i class="bi bi-exclamation-triangle"></i> @modalError
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="SubmitAppointment" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span> Guardando...</span>
                        }
                        else
                        {
                            <span>Confirmar Cita</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // Cierres del taller: el tablero y el modal solo permiten agendar dentro de esta ventana.
    private static readonly TimeOnly Apertura = new(8, 0);
    private static readonly TimeOnly Cierre = new(18, 0);
    private const int PasoMinutos = 30;
    private static readonly CultureInfo EsCr = new("es-CR");

    private System.Timers.Timer? debounceTimer;

    // Búsqueda de cliente
    private string searchTerm = "";
    private bool isSearching = false;
    private List<Cliente>? clientesEncontrados;
    private Cliente? selectedCliente;

    // Tablero
    private bool cargando = true;
    private readonly DateTime hoy = DateTime.Today;
    private DateTime semanaInicio;
    private List<MecanicoDTO> mecanicos = new();
    private List<Cita> citasSemana = new();

    // Modal
    private bool showModal;
    private bool isSubmitting;
    private string? modalError;
    private string? successMessage;
    private string? errorMessage;

    private DateTime selectedFecha;
    private HashSet<int> selMecanicosIds = new();
    private TimeOnly selHora = Apertura;
    private TimeOnly selectedHoraFin;
    private Servicio? selectedServicio;

    private List<Vehiculo>? vehiculosCliente;
    private List<Servicio>? serviciosActivos;
    private List<Servicio> serviciosDelMecanico = new();

    private AgendarCitaDTO citaDto = new();

    // ~~~ Ciclo de vida ~~~
    protected override async Task OnInitializedAsync()
    {
        debounceTimer = new System.Timers.Timer(300);
        debounceTimer.AutoReset = false;
        debounceTimer.Elapsed += async (s, e) => await InvokeAsync(PerformSearch);

        semanaInicio = LunesDe(hoy);
        serviciosActivos = await ServicioService.ObtenerTodosActivosAsync();
        await CargarTablero();
    }

    public void Dispose() => debounceTimer?.Dispose();

    private async Task CargarTablero()
    {
        cargando = true;
        try
        {
            // La semana visible va de lunes a sábado (el domingo el taller está cerrado).
            var citas = await CitaService.ObtenerPorRangoAsync(semanaInicio, semanaInicio.AddDays(5));
            citasSemana = citas.Where(c => c.Estado != EstadoCita.Cancelado).ToList();

            // Se muestran los mecánicos activos y, además, los inactivos que aún tienen
            // citas vigentes en la semana visible: así el administrador no pierde de vista
            // las citas pendientes de un mecánico dado de baja y puede reasignarlas.
            var inactivosConCitas = citasSemana
                .SelectMany(c => c.CitaMecanicos.Select(cm => cm.MecanicoId))
                .ToHashSet();
            mecanicos = (await MecanicoService.ObtenerTodosAsync(FiltroActivo.Todos))
                .Where(m => m.Activo || inactivosConCitas.Contains(m.Id))
                .ToList();
        }
        finally
        {
            cargando = false;
        }
    }

    // ~~~ Búsqueda de cliente ~~~
    private void HandleSearch()
    {
        isSearching = true;
        debounceTimer?.Stop();
        debounceTimer?.Start();
    }

    private async Task PerformSearch()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            clientesEncontrados = null;
            isSearching = false;
            StateHasChanged();
            return;
        }

        clientesEncontrados = await ClienteService.BuscarClientesAsync(searchTerm);
        isSearching = false;
        StateHasChanged();
    }

    private void SelectCliente(Cliente cliente)
    {
        selectedCliente = cliente;
        searchTerm = "";
        clientesEncontrados = null;
    }

    private void DeselectCliente()
    {
        selectedCliente = null;
        vehiculosCliente = null;
    }

    // ~~~ Navegación de semana ~~~
    private static DateTime LunesDe(DateTime fecha)
    {
        int delta = ((int)fecha.DayOfWeek + 6) % 7; // lunes = 0, ... domingo = 6
        return fecha.Date.AddDays(-delta);
    }

    private DateTime LunesActual => LunesDe(hoy);
    private bool EsSemanaActual => semanaInicio.Date == LunesActual;
    private bool PuedeRetroceder => semanaInicio.Date > LunesActual;

    private List<DateTime> DiasSemana => Enumerable.Range(0, 6).Select(i => semanaInicio.AddDays(i)).ToList();

    private string EtiquetaSemana
    {
        get
        {
            var fin = semanaInicio.AddDays(5);
            return semanaInicio.Month == fin.Month
                ? $"{semanaInicio.Day} – {fin.Day} {fin.ToString("MMM yyyy", EsCr)}"
                : $"{semanaInicio.ToString("d MMM", EsCr)} – {fin.ToString("d MMM yyyy", EsCr)}";
        }
    }

    private async Task SemanaAnterior()
    {
        if (!PuedeRetroceder) return;
        semanaInicio = semanaInicio.AddDays(-7);
        await CargarTablero();
    }

    private async Task SemanaSiguiente()
    {
        semanaInicio = semanaInicio.AddDays(7);
        await CargarTablero();
    }

    private async Task IrHoy()
    {
        semanaInicio = LunesActual;
        await CargarTablero();
    }

    // ~~~ Render del tablero ~~~
    // Una cita aparece en la fila de CADA mecánico asignado (misma cita, varias filas).
    private List<Cita> CitasDe(int mecanicoId, DateTime dia) =>
        citasSemana
            .Where(c => c.CitaMecanicos.Any(cm => cm.MecanicoId == mecanicoId) && c.Fecha.Date == dia.Date)
            .OrderBy(c => c.HoraInicio)
            .ToList();

    // Un clic en el chip de una cita abre su detalle en lugar del modal de agendado
    // (el chip detiene la propagación para no disparar el @onclick de la celda).
    private void IrACita(int citaId) => Nav.NavigateTo($"citas/{citaId}");

    // Tooltip del chip: servicio · cliente, con aviso extra si el cliente está inactivo.
    private static string TituloChip(Cita cita) =>
        $"{cita.Servicio?.Nombre} · {cita.Cliente?.NombreCompleto}{(cita.Cliente?.Activo == false ? " · Cliente inactivo" : "")}";

    private bool PuedeAgendar(DateTime dia) => selectedCliente != null && dia.Date >= hoy;

    private string ClaseCabeceraDia(DateTime dia)
    {
        var clases = "col-dia";
        if (dia.Date == hoy) clases += " es-hoy";
        if (dia.Date < hoy) clases += " es-pasado";
        return clases;
    }

    private string ClaseCelda(MecanicoDTO mecanico, DateTime dia)
    {
        var clases = "celda-dia";
        if (dia.Date == hoy) clases += " es-hoy";
        if (dia.Date < hoy) clases += " es-pasado";
        // Las celdas de un mecánico inactivo no se marcan como clicables: no se
        // agendan citas nuevas sobre él, solo se visualizan y reasignan las existentes.
        if (PuedeAgendar(dia) && mecanico.Activo) clases += " es-clicable";
        return clases;
    }

    private static string CssEstado(EstadoCita estado) => estado switch
    {
        EstadoCita.Pendiente => "pendiente",
        EstadoCita.Confirmado => "confirmado",
        EstadoCita.EnProceso => "proceso",
        EstadoCita.Finalizado => "finalizado",
        EstadoCita.Cancelado => "cancelado",
        _ => "cancelado"
    };

    // ~~~ Modal ~~~ 
    private IEnumerable<TimeOnly> HorasDelDia
    {
        get
        {
            for (var t = Apertura; t < Cierre; t = t.AddMinutes(PasoMinutos))
            {
                yield return t;
            }
        }
    }

    private bool HoraHabilitada(TimeOnly h)
    {
        if (selectedFecha.Date == hoy && h.ToTimeSpan() <= DateTime.Now.TimeOfDay)
        {
            return false;
        }

        var duracion = selectedServicio?.DuracionMinutos ?? PasoMinutos;
        var fin = ServicioService.CalcularHoraFin(h, duracion);

        if (selectedServicio != null && fin > Cierre)
        {
            return false;
        }

        // El horario se ocupa por mecánico: otro mecánico libre puede usar la misma hora.
        if (MecanicoOcupado(h, fin))
        {
            return false;
        }

        return true;
    }

    private TimeOnly HoraInicialPorDefecto(DateTime dia)
    {
        var t = Apertura;
        if (dia.Date == hoy)
        {
            var ahora = TimeOnly.FromDateTime(DateTime.Now);
            while (t < ahora && t < Cierre)
            {
                t = t.AddMinutes(PasoMinutos);
            }
        }

        // Salta los tramos donde el mecánico ya tiene una cita activa (referencia de 30 min).
        while (t < Cierre && MecanicoOcupado(t, ServicioService.CalcularHoraFin(t, PasoMinutos)))
        {
            t = t.AddMinutes(PasoMinutos);
        }

        return t >= Cierre ? new TimeOnly(17, 30) : t;
    }

    private async Task AbrirModal(MecanicoDTO mecanico, DateTime dia)
    {
        // No se agendan citas nuevas sobre un mecánico inactivo (defensa extra a nivel
        // de UI: sus celdas ya no son clicables en el tablero).
        if (!PuedeAgendar(dia) || selectedCliente == null || !mecanico.Activo)
        {
            return;
        }

        selectedFecha = dia.Date;
        selMecanicosIds = new HashSet<int> { mecanico.Id };
        selHora = HoraInicialPorDefecto(dia);
        selectedServicio = null;
        selectedHoraFin = default;
        ActualizarServiciosDelMecanico();
        modalError = null;
        citaDto = new AgendarCitaDTO
        {
            ClienteId = selectedCliente.ClienteId,
            Fecha = selectedFecha,
            HoraInicio = selHora
        };

        vehiculosCliente = await VehiculoService.ObtenerPorClienteAsync(selectedCliente.ClienteId);
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        modalError = null;
    }

    private void OnHoraChanged(ChangeEventArgs e)
    {
        if (TimeOnly.TryParse(e.Value?.ToString(), CultureInfo.InvariantCulture, out var h))
        {
            selHora = h;
            citaDto.HoraInicio = h;

            if (selectedServicio != null)
            {
                selectedHoraFin = ServicioService.CalcularHoraFin(h, selectedServicio.DuracionMinutos);
            }
        }
    }

    private void OnVehiculoChanged(ChangeEventArgs e)
    {
        citaDto.VehiculoId = int.TryParse(e.Value?.ToString(), out int id) && id > 0 ? id : null;
    }

    private void ToggleMecanico(int mecanicoId, ChangeEventArgs e)
    {
        var especialidadAntes = EspecialidadSeleccionadaId;

        if (e.Value is bool marcado && marcado)
        {
            selMecanicosIds.Add(mecanicoId);
        }
        else
        {
            selMecanicosIds.Remove(mecanicoId);
        }

        // El servicio depende de la especialidad de los mecánicos elegidos: si cambia
        // (en la práctica, al pasar de vacío a una especialidad), se reinicia.
        if (EspecialidadSeleccionadaId != especialidadAntes)
        {
            selectedServicio = null;
            selectedHoraFin = default;
            citaDto.ServicioId = 0;
            ActualizarServiciosDelMecanico();
        }
    }

    private void OnServiceChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int servicioId) && servicioId > 0)
        {
            // Solo se ofrecen (y aceptan) servicios de la especialidad del mecánico elegido.
            selectedServicio = serviciosDelMecanico.FirstOrDefault(s => s.ServicioId == servicioId);
            if (selectedServicio != null)
            {
                citaDto.ServicioId = selectedServicio.ServicioId;
                selectedHoraFin = ServicioService.CalcularHoraFin(selHora, selectedServicio.DuracionMinutos);
            }
        }
        else
        {
            selectedServicio = null;
            citaDto.ServicioId = 0;
            selectedHoraFin = default;
        }
    }

    private List<MecanicoDTO> MecanicosSeleccionados =>
        mecanicos.Where(m => selMecanicosIds.Contains(m.Id)).OrderBy(m => m.Nombre).ToList();

    private string MecanicosSeleccionadosNombres =>
        string.Join(", ", MecanicosSeleccionados.Select(m => m.Nombre));

    // Especialidad (compartida) de los mecánicos elegidos; null si aún no hay ninguno.
    private int? EspecialidadSeleccionadaId =>
        mecanicos.FirstOrDefault(m => selMecanicosIds.Contains(m.Id))?.EspecialidadId;

    // Agrupación de los mecánicos activos por especialidad, para la lista de checkboxes.
    private IEnumerable<IGrouping<int, MecanicoDTO>> MecanicosPorEspecialidad =>
        mecanicos.Where(m => m.Activo)
            .GroupBy(m => m.EspecialidadId)
            .OrderBy(g => g.First().EspecialidadNombre);

    // Solo se permite combinar mecánicos de la misma especialidad: una vez elegido uno,
    // los grupos de otras especialidades quedan deshabilitados.
    private bool GrupoHabilitado(int especialidadId) =>
        !selMecanicosIds.Any() || EspecialidadSeleccionadaId == especialidadId;

    private void ActualizarServiciosDelMecanico()
    {
        var especialidadId = EspecialidadSeleccionadaId;
        serviciosDelMecanico = especialidadId is null || serviciosActivos == null
            ? new List<Servicio>()
            : serviciosActivos.Where(s => s.CategoriaId == especialidadId).ToList();
    }

    private bool MecanicoOcupado(TimeOnly ini, TimeOnly fin)
    {
        if (!selMecanicosIds.Any())
        {
            return false;
        }

        return citasSemana.Any(c =>
            c.CitaMecanicos.Any(cm => selMecanicosIds.Contains(cm.MecanicoId))
            && c.Fecha.Date == selectedFecha.Date
            && c.EstaActiva()
            && c.OverlapsWith(ini, fin));
    }

    private async Task SubmitAppointment()
    {
        modalError = null;

        if (selectedCliente == null)
        {
            modalError = "Seleccione un cliente.";
            return;
        }
        if (citaDto.VehiculoId == null)
        {
            modalError = "Seleccione un vehículo.";
            return;
        }
        if (selectedServicio == null)
        {
            modalError = "Seleccione un servicio.";
            return;
        }
        if (selMecanicosIds.Count == 0)
        {
            modalError = "Seleccione al menos un mecánico.";
            return;
        }
        if (!HoraHabilitada(selHora))
        {
            modalError = "El horario seleccionado ya no está disponible.";
            return;
        }

        selectedHoraFin = ServicioService.CalcularHoraFin(selHora, selectedServicio.DuracionMinutos);
        if (selectedHoraFin > Cierre)
        {
            modalError = "La cita terminaría después del horario de atención (6:00 p. m.).";
            return;
        }

        citaDto.ClienteId = selectedCliente.ClienteId;
        citaDto.Fecha = selectedFecha;
        citaDto.HoraInicio = selHora;
        citaDto.ServicioId = selectedServicio.ServicioId;
        citaDto.MecanicosIds = selMecanicosIds.ToList();

        isSubmitting = true;
        try
        {
            var nuevaCita = await CitaService.AgendarCitaAsync(citaDto);

            successMessage = "Cita agendada exitosamente. Se ha enviado una notificación.";
            await NotificationService.NotificarCitaAgendadaAsync(nuevaCita);

            CloseModal();
            await CargarTablero();
        }
        catch (Exception ex) when (ex.GetType().Name == "AppointmentOverlapException")
        {
            modalError = ex.Message;
        }
        catch (Exception ex) when (ex.GetType().Name == "InactiveMechanicException")
        {
            modalError = ex.Message;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al agendar la cita: {ex.Message}";
            CloseModal();
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
