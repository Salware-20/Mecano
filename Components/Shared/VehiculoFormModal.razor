@* Modal de crear/editar vehículo reutilizable (ClienteDetalle y VehiculoDetalle).
   El dueño maneja el estado (modelo, guardando, error) y las acciones;
   aquí solo vive el formulario, para no duplicar sus campos. *@
<div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5);">
    <div class="modal-dialog">
        <div class="modal-content">
            <EditForm Model="Model" OnValidSubmit="Submit" FormName="@FormName">
                <DataAnnotationsValidator />
                <div class="modal-header">
                    <h5 class="modal-title">
                        @(EsEdicion ? "Editar vehículo" : "Nuevo vehículo")
                    </h5>
                    <button type="button" class="btn-close" @onclick="OnCancelar"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(MensajeError))
                    {
                        <div class="alert alert-danger">@MensajeError</div>
                    }

                    <div class="mb-3">
                        <label class="form-label" for="vehPlaca">Placa *</label>
                        <InputText id="vehPlaca" class="form-control" @bind-Value="Model.Placa"
                                   placeholder="Ej. ABC123" />
                        <ValidationMessage For="() => Model.Placa" class="text-danger small" />
                        <div class="form-text">6 caracteres alfanuméricos, sin guiones.</div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="vehMarca">Marca *</label>
                            <InputText id="vehMarca" class="form-control" @bind-Value="Model.Marca"
                                       placeholder="Ej. Toyota" />
                            <ValidationMessage For="() => Model.Marca" class="text-danger small" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="vehModelo">Modelo *</label>
                            <InputText id="vehModelo" class="form-control" @bind-Value="Model.Modelo"
                                       placeholder="Ej. Corolla" />
                            <ValidationMessage For="() => Model.Modelo" class="text-danger small" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="vehAnio">Año *</label>
                            <InputNumber id="vehAnio" class="form-control" @bind-Value="Model.Anio"
                                         placeholder="Ej. 2020" />
                            <ValidationMessage For="() => Model.Anio" class="text-danger small" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="vehKilometraje">Kilometraje</label>
                            <InputNumber id="vehKilometraje" class="form-control" @bind-Value="Model.Kilometraje"
                                         placeholder="Ej. 45000" />
                            <ValidationMessage For="() => Model.Kilometraje" class="text-danger small" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="vehColor">Color</label>
                        <InputText id="vehColor" class="form-control" @bind-Value="Model.Color"
                                   placeholder="Ej. Blanco" />
                        <ValidationMessage For="() => Model.Color" class="text-danger small" />
                    </div>

                    <div class="mb-1">
                        <label class="form-label" for="vehNotas">Notas</label>
                        <InputTextArea id="vehNotas" class="form-control" rows="3" @bind-Value="Model.Notas"
                                       placeholder="Detalles u observaciones del vehículo" />
                        <ValidationMessage For="() => Model.Notas" class="text-danger small" />
                    </div>
                </div>
                <div class="modal-footer justify-content-between">
                    <div>
                        @FooterIzquierdo
                    </div>
                    <div class="btn-group">
                        <button type="button" class="btn btn-secondary" @onclick="OnCancelar">
                            Cancelar
                        </button>
                        <button type="submit" class="btn btn-primary" disabled="@Guardando">
                            @if (Guardando)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Guardar
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>
</div>
